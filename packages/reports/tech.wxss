.result-page { position: relative; min-height: 100vh; color: #eafff9; background: radial-gradient(circle at 90% 6%, rgba(105,87,226,.15), transparent 25%), radial-gradient(circle at 8% 26%, rgba(65,218,186,.1), transparent 27%), linear-gradient(160deg, #071720, #06111b 58%, #091723); overflow: hidden; }
.result-page::before { content: ''; position: fixed; inset: 0; pointer-events: none; opacity: .18; background-image: linear-gradient(rgba(99,235,210,.07) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(99,235,210,.07) 1rpx, transparent 1rpx); background-size: 54rpx 54rpx; mask-image: linear-gradient(to bottom, #000, transparent 72%); }
.result-page > view, .result-page > block { position: relative; z-index: 1; }
.result-page .eyebrow { color: #65d9c1; letter-spacing: 3rpx; }
.result-page .result-header, .result-page .content-card, .result-page .state-card { border-color: rgba(104,184,178,.18); background: linear-gradient(145deg, rgba(15,40,51,.95), rgba(8,27,38,.93)); box-shadow: 0 24rpx 65rpx rgba(0,0,0,.27), inset 0 1rpx rgba(255,255,255,.06); animation: reportRise .5s ease; }
.result-page .result-icon { color: #dfffb7; background: linear-gradient(145deg, rgba(95,230,203,.18), rgba(102,84,218,.14)); box-shadow: inset 0 0 28rpx rgba(108,241,212,.1), 0 0 35rpx rgba(69,220,190,.12); animation: reportCore 3s ease-in-out infinite; }
.result-page .result-image { box-shadow: 0 16rpx 35rpx rgba(0,0,0,.25); }.result-page .result-type { color: #f0fffb; }.result-page .result-code { color: #67dec3; }.result-page .result-summary { color: #93aaa6; }.result-page .saved-badge { color: #68e2c5; background: rgba(91,225,194,.1); border: 1rpx solid rgba(91,225,194,.15); }
.result-page .report-tier-label { color: #6e898d; }.result-page .report-tier-label text:first-child { color: #64dfc2; }.result-page .basic-report-card { border-top-color: #56daba; }.result-page .section-title { color: #e9faf6; }.result-page .body-copy { color: #93aaa5; }
.result-page .dimension-heading { color: #b6d3cc; }.result-page .dimension-track { background: #15343c; }.result-page .dimension-fill { background: linear-gradient(90deg, #4fd5b7, #75edcd, #d4c26b); box-shadow: 0 0 16rpx rgba(83,223,192,.25); }.result-page .dimension-summary { color: #708d90; }
.result-page .advice-box { color: #c8b978; background: rgba(104,82,31,.35); border: 1rpx solid rgba(215,190,96,.18); }.result-page .report-note, .result-page .local-note { color: #607e82; }.result-page .legacy-note { color: #d8be75; background: rgba(84,63,25,.4); border: 1rpx solid rgba(221,186,83,.2); }
.result-page .premium-lock-card, .result-page .premium-report-header { border-color: rgba(105,236,208,.24); background: radial-gradient(circle at 90% 0, rgba(113,90,226,.18), transparent 35%), linear-gradient(145deg, #102e35, #081d29); box-shadow: 0 24rpx 60rpx rgba(0,0,0,.3); }.result-page .premium-kicker { color: #ddca73; }.result-page .premium-title { color: #f0fffa; }.result-page .premium-subtitle { color: #8da8a5; }.result-page .premium-preview-grid view { border-color: rgba(101,220,199,.14); background: rgba(91,224,194,.05); }.result-page .premium-preview-grid text:first-child { color: #78e4ca; }.result-page .premium-preview-grid text:last-child { color: #708d91; }.result-page .premium-unlock-button { color: #06201e; background: linear-gradient(100deg, #62e4c6, #a8ebbd 60%, #dbc86d); box-shadow: 0 14rpx 32rpx rgba(62,211,182,.2); animation: unlockGlow 2.2s ease-in-out infinite alternate; }
.result-page .premium-tabs { background: #081c27; border-color: rgba(99,224,200,.16); }.result-page .premium-tab { color: #6f8d91; background: rgba(82,198,182,.04); }.result-page .premium-tab-active { color: #07201e; background: linear-gradient(135deg, #68e2c4, #d7c76e); }.result-page .premium-page { border-color: rgba(99,224,200,.16); }
.result-page .archive-link { border: 1rpx solid rgba(98,220,196,.18); background: linear-gradient(120deg, rgba(18,53,59,.92), rgba(14,42,53,.9)); }.result-page .archive-title { color: #baf0e4; }.result-page .archive-subtitle { color: #6d898c; }.result-page .archive-arrow { color: #67e1c5; }
.result-page .primary-button { color: #06201e; background: linear-gradient(100deg, #62e4c6, #b4e6a9); }.result-page .secondary-button { color: #72dfc7; background: rgba(12,34,44,.8); border-color: rgba(99,221,197,.22); }.result-page .text-button { color: #65cdb8; }.result-page .muted { color: #5d777d; }
.result-page .state-leaf { color: #68e4c6; text-shadow: 0 0 24rpx rgba(92,228,198,.35); }.result-page .state-title { color: #eafff9; }.result-page .state-copy { color: #789398; }
@keyframes reportRise { from { opacity: 0; transform: translateY(24rpx); } to { opacity: 1; transform: none; } }
@keyframes reportCore { 0%,100% { transform: scale(.96); box-shadow: 0 0 20rpx rgba(69,220,190,.08); } 50% { transform: scale(1.03); box-shadow: 0 0 42rpx rgba(69,220,190,.2); } }
@keyframes unlockGlow { from { box-shadow: 0 10rpx 24rpx rgba(62,211,182,.14); } to { box-shadow: 0 14rpx 38rpx rgba(62,211,182,.34); } }
