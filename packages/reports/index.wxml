<view class="result-page report-theme-{{themeId || 'adventurer'}}">
  <view wx:if="{{state === 'loading'}}" class="state-card">正在展开你的报告…</view>
  <view wx:elif="{{state !== 'ready'}}" class="state-card">
    <view class="state-leaf">❧</view>
    <view class="state-title">{{stateTitle}}</view>
    <view class="state-copy">{{stateMessage}}</view>
    <button wx:if="{{test.id && state !== 'error'}}" class="primary-button" bindtap="retakeTest">开始这项探索</button>
    <button class="text-button" bindtap="goToHome">返回探索大厅</button>
  </view>
  <block wx:else>
    <view class="report-page-heading"><view><view class="report-heading-title">我的人格报告</view><view class="report-heading-subtitle">{{test.name}} · {{playful ? '趣味探索' : '本次测评'}}</view></view><view class="report-heading-mark">{{premiumUnlocked ? '深度版已解锁' : '基础报告'}}</view></view>
    <view class="result-header">
      <view class="result-header-glow"></view>
      <image wx:if="{{result.image}}" class="result-image" src="{{result.image}}" mode="aspectFit" lazy-load="{{true}}" />
      <view wx:elif="{{themeHeroUrl}}" class="report-tree-scene"><image class="report-theme-hero" src="{{themeHeroUrl}}" mode="aspectFit" /><view class="report-theme-caption">我的树 · {{themeName}}</view></view>
      <view wx:elif="{{record.treeSnapshot}}" class="report-tree-scene report-tree-fallback"><personality-tree tree="{{record.treeSnapshot}}" size="large" /></view>
      <view wx:else class="result-icon">{{resultIcon}}</view>
      <view class="result-type">{{result.title}}</view>
      <view class="result-code" wx:if="{{result.type !== 'profile'}}">{{result.type}}</view>
      <view class="result-summary">{{result.summary}}</view>
      <view class="saved-badge">已收集 · {{savedAt}}</view>
      <view wx:if="{{themeHeroUrl && !result.image}}" class="report-companion-line">{{companionNames}}，陪你看见更多面的自己</view>
    </view>
    <view wx:if="{{legacy}}" class="legacy-note">这是旧版本记录，不用于新版人格树匹配。重新测试会保留这份历史记录。</view>
    <view class="report-tier-label"><text>基础报告</text><text>完成测试即可查看</text></view>
    <view class="content-card basic-report-card">
      <view class="section-title">这一次，看见自己</view>
      <view class="body-copy">{{result.description}}</view>
      <view wx:if="{{basicDimensions.length}}" class="dimensions basic-dimensions">
        <view class="dimension" wx:for="{{basicDimensions}}" wx:key="id">
          <view class="dimension-heading"><text>{{item.label}}</text><text>{{item.score}} / 5 · {{item.level}}</text></view>
          <view class="dimension-track"><view class="dimension-fill" style="width: {{item.percent}}%"></view></view>
          <view class="dimension-summary">{{item.summary}}</view>
        </view>
      </view>
      <view class="advice-box"><view class="advice-label">给自己的小提醒</view>{{result.advice}}</view>
      <view wx:if="{{result.note}}" class="report-note">{{result.note}}</view>
    </view>

    <view wx:if="{{premiumAvailable && !premiumUnlocked}}" class="premium-lock-card">
      <view class="premium-kicker"><text class="premium-crown">✦</text> VIP 深度版</view>
      <view class="premium-title">不止看见结果，更看懂自己</view>
      <view class="premium-subtitle">{{deepReport.tagline}}</view>
      <view class="premium-preview-grid">
        <view><text>完整维度</text><text>全部倾向与强度</text></view>
        <view><text>优势盲区</text><text>适用场景与提醒</text></view>
        <view><text>关系模式</text><text>沟通与边界建议</text></view>
        <view><text>行动方案</text><text>3 个具体练习</text></view>
      </view>
      <button class="premium-unlock-button" bindtap="showPremiumAd" loading="{{adWatching}}" disabled="{{adWatching}}">
        {{adWatching ? '正在打开视频…' : '观看视频，解锁本次深度报告'}}
      </button>
      <view class="premium-rule">完整观看 1 次激励视频 · 仅解锁当前这次测评 · 以后可直接回看</view>
      <view wx:if="{{adError}}" class="ad-error">{{adError}}</view>
    </view>

    <view wx:if="{{premiumAvailable && premiumUnlocked}}" class="premium-report">
      <view class="premium-report-header">
        <view class="premium-kicker"><text class="premium-crown">✦</text> VIP 深度版 · {{premiumSavePending ? '待保存' : '已解锁'}}</view>
        <view class="premium-title">{{deepReport.title}}</view>
        <view class="premium-subtitle">{{deepReport.tagline}}</view>
        <view class="premium-unlocked-at">解锁于 {{premiumUnlockedAt}}</view>
      </view>

      <view wx:if="{{premiumSavePending}}" class="premium-save-banner">
        <view class="premium-save-title">视频已看完，当前可查看完整报告</view>
        <view class="premium-save-copy">{{premiumSaveError || '解锁状态正在等待保存。'}}恢复存储空间后可直接重试，无需重新观看广告。</view>
        <button class="premium-save-button" bindtap="retryPremiumSave" loading="{{premiumSaving}}" disabled="{{premiumSaving}}">{{premiumSaving ? '正在保存…' : '重试保存解锁状态'}}</button>
      </view>

      <view class="premium-tabs">
        <view class="premium-tab {{premiumPage === 'portrait' ? 'premium-tab-active' : ''}}" data-page="portrait" bindtap="selectPremiumPage"><text>01</text>画像图表</view>
        <view class="premium-tab {{premiumPage === 'insights' ? 'premium-tab-active' : ''}}" data-page="insights" bindtap="selectPremiumPage"><text>02</text>深度解读</view>
        <view class="premium-tab {{premiumPage === 'actions' ? 'premium-tab-active' : ''}}" data-page="actions" bindtap="selectPremiumPage"><text>03</text>行动卡</view>
      </view>

      <view wx:if="{{premiumPage === 'portrait'}}" class="premium-page portrait-page">
        <view class="portrait-card">
          <view class="capture-label"><text>PERSONAL MAP</text><text>适合截图保存</text></view>
          <view class="portrait-heading"><view><view class="portrait-test">{{test.name}} · 本次画像</view><view class="portrait-title">{{result.title}}</view><view class="portrait-tagline">{{deepReport.tagline}}</view></view><view wx:if="{{themeHeroUrl || record.treeSnapshot}}" class="portrait-tree"><image wx:if="{{themeHeroUrl}}" class="portrait-theme-image" src="{{themeHeroUrl}}" mode="aspectFit" /><personality-tree wx:else tree="{{record.treeSnapshot}}" size="small" /></view></view>
          <view wx:if="{{themeHeroUrl}}" class="portrait-theme-label">我的树 · {{themeName}}<text>当前主题意象，图表对应本次结果</text></view>
          <view class="chart-title"><text>倾向清晰度图</text><text>越靠外，表示本次偏好越清晰</text></view>
          <profile-radar wx:if="{{deepReport.dimensions.length >= 3}}" dimensions="{{deepReport.dimensions}}" />
          <view wx:else class="single-spectrum">
            <view class="single-spectrum-labels"><text>{{deepReport.dimensions[0].left}}</text><text>{{deepReport.dimensions[0].right}}</text></view>
            <view class="single-spectrum-track"><view class="single-spectrum-mid"></view><view class="single-spectrum-dot" style="left:{{deepReport.dimensions[0].percent}}%;"></view></view>
            <view class="single-spectrum-result">本次更靠近 · {{deepReport.dimensions[0].preference}}</view>
          </view>
          <view class="profile-legend">
            <view wx:for="{{deepReport.dimensions}}" wx:key="id" class="legend-item legend-{{item.tone}}"><view class="legend-top"><text>{{item.label}}</text><text>{{item.scoreText}}</text></view><view class="legend-preference">{{item.preference}} · 清晰度 {{item.clarity}}%</view></view>
          </view>
          <view class="portrait-summary">
            <view class="portrait-summary-title">本次画像关键词</view>
            <view class="highlight-list"><view wx:for="{{deepReport.highlights}}" wx:key="id" class="highlight-chip">{{item.preference}}</view></view>
            <view wx:if="{{deepReport.balancedCount}}" class="balance-note">其中 {{deepReport.balancedCount}} 个维度接近中间，说明你可能会随情境调整。</view>
          </view>
          <view class="capture-footer"><text>人格测试树</text><text>{{savedAt}}</text></view>
        </view>
        <view class="chart-note">图表展示本次自评的倾向位置和清晰程度，不代表能力高低或人群排名。</view>
      </view>

      <view wx:elif="{{premiumPage === 'insights'}}" class="premium-page insight-page">
        <view class="page-number">02 / 03 · DEEP INSIGHTS</view>
        <view class="premium-section-title">把图表放回真实生活</view>
        <view class="insight-visual-grid">
          <view class="visual-insight-card" wx:for="{{deepReport.sections}}" wx:key="title">
            <view class="insight-symbol">{{item.icon}}</view>
            <view class="insight-title">{{item.title}}</view>
            <view class="insight-content">{{item.content}}</view>
          </view>
        </view>
        <view class="insight-reminder"><text>读报告的小方法</text><view>先找最有共鸣的一段，再想起一个真实场景。能对应到生活里的部分，才是这份报告真正有用的地方。</view></view>
      </view>

      <view wx:else class="premium-page action-page">
        <view class="page-number">03 / 03 · ACTION PLAN</view>
        <view class="premium-section-title">把认识自己变成三个小行动</view>
        <view class="action-timeline">
          <view class="action-plan-item" wx:for="{{deepReport.actionPlan}}" wx:key="timing">
            <view class="action-marker"><view class="action-dot"></view><view wx:if="{{index < deepReport.actionPlan.length - 1}}" class="action-line"></view></view>
            <view class="action-plan-card"><view class="action-timing">{{item.timing}}</view><view class="action-content">{{item.content}}</view><view class="action-check">□ 完成后给自己留一句记录</view></view>
          </view>
        </view>
        <view class="action-save-card"><view class="action-save-icon">✦</view><view><view class="action-save-title">建议截图保存这一页</view><view class="action-save-copy">完成一个就回来打一个勾。30 天后复测时，对照这次行动和维度变化。</view></view></view>
      </view>
      <view class="premium-note">{{deepReport.note}}</view>
    </view>
    <view class="archive-link" bindtap="goToArchive" hover-class="pressed">
      <view><view class="archive-title">你的人格树，留下了新记录</view><view class="archive-subtitle">查看成长档案与历次测评</view></view>
      <text class="archive-arrow">→</text>
    </view>
    <view class="local-note">报告默认保留在本机。开启云备份后，仅同步结果摘要与解锁记录，不上传逐题选项。测评用于自我探索，不作心理诊断。</view>
    <view class="result-actions">
      <button class="secondary-button" bindtap="retakeTest">再测一次</button>
      <button class="primary-button" bindtap="goToArchive">我的档案</button>
    </view>
    <button open-type="share" class="text-button">邀请朋友一起探索 ↗</button>
    <button class="text-button muted" bindtap="goToHome">返回探索大厅</button>
  </block>
</view>
