:host {
  display: block;
}
.radar-shell {
  position: relative;
  width: 430rpx;
  height: 430rpx;
  margin: 0 auto;
}
.radar-shell::before {
  content: '';
  position: absolute;
  inset: 11%;
  border-radius: 50%;
  border: 1rpx solid rgba(89, 147, 235, 0.18);
  background: radial-gradient(circle, rgba(174, 207, 255, 0.16), transparent 68%);
}
.radar-canvas {
  position: relative;
  width: 430rpx;
  height: 430rpx;
}
.radar-center {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 28rpx;
  height: 28rpx;
  margin: -14rpx 0 0 -14rpx;
  border-radius: 50%;
  background: rgba(55, 112, 223, 0.92);
  color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 0;
  line-height: 1.25;
  letter-spacing: 1rpx;
  box-shadow: 0 0 0 10rpx rgba(93, 145, 232, .11), 0 6rpx 18rpx rgba(58, 118, 217, 0.18);
}
.radar-center-label { display: none; }
