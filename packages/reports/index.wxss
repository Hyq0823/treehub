@import "./premium-visual.wxss";
@import "./tech.wxss";
page {
  background: #faf7ef;
  color: #142c35;
}
.result-page {
  padding: 36rpx 32rpx 64rpx;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}
.starter-reveal-mask {
  position: fixed;
  z-index: 120;
  inset: 0;
  background: rgba(17, 37, 66, .56);
  backdrop-filter: blur(14rpx);
  display: flex;
  align-items: flex-end;
}
.starter-reveal-sheet {
  width: 100%;
  height: 94vh;
  padding: 34rpx 30rpx calc(42rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 46rpx 46rpx 0 0;
  background: linear-gradient(180deg, #f6fbff 0%, #fff 52%, #f8fbff 100%);
  box-shadow: 0 -20rpx 70rpx rgba(22, 65, 112, .24);
}
.starter-reveal-topline { display: flex; align-items: center; justify-content: space-between; color: #6681a5; font-size: 21rpx; letter-spacing: 2rpx; }
.starter-reveal-skip { min-height: 64rpx; line-height: 64rpx; padding: 0 4rpx 0 28rpx; color: #4c6f99; letter-spacing: 0; }
.starter-reveal-kicker { margin-top: 18rpx; color: #347fdb; font-size: 24rpx; font-weight: 700; }
.starter-reveal-title { margin-top: 8rpx; color: #183a63; font-size: 44rpx; line-height: 1.3; font-weight: 800; }
.starter-reveal-copy { margin-top: 12rpx; color: #607997; font-size: 25rpx; line-height: 1.7; }
.starter-scene { position: relative; height: 500rpx; margin-top: 24rpx; overflow: hidden; border: 1rpx solid rgba(111, 161, 215, .24); border-radius: 34rpx; box-shadow: 0 18rpx 52rpx rgba(60, 125, 192, .13); }
.starter-scene-image { position: relative; z-index: 2; width: 100%; height: 100%; }
.starter-scene-orbit { position: absolute; border: 1rpx solid rgba(91, 151, 215, .18); border-radius: 50%; }
.starter-orbit-one { width: 430rpx; height: 430rpx; left: -120rpx; top: 160rpx; }
.starter-orbit-two { width: 270rpx; height: 270rpx; right: -70rpx; top: -80rpx; }
.starter-scene-fallback { position: relative; z-index: 2; height: 100%; display: flex; align-items: center; justify-content: center; gap: 22rpx; color: #4b80bf; font-size: 76rpx; }
.starter-fallback-tree { color: #377acb; font-size: 210rpx; }
.starter-recommend-badge { position: absolute; z-index: 3; left: 24rpx; top: 24rpx; padding: 12rpx 20rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .9); color: #317cd2; font-size: 21rpx; font-weight: 700; box-shadow: 0 8rpx 24rpx rgba(44, 105, 172, .12); }
.starter-theme-name { margin-top: 28rpx; color: #183a63; font-size: 40rpx; font-weight: 800; text-align: center; }
.starter-theme-quote { margin-top: 10rpx; color: #4d75a4; font-size: 27rpx; line-height: 1.6; text-align: center; }
.starter-theme-description { margin: 12rpx auto 0; max-width: 600rpx; color: #71869f; font-size: 24rpx; line-height: 1.7; text-align: center; }
.starter-tags { display: flex; justify-content: center; gap: 12rpx; margin-top: 18rpx; }
.starter-tags text { padding: 9rpx 18rpx; border-radius: 999rpx; background: #edf5ff; color: #4776ae; font-size: 21rpx; }
.starter-companions { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 24rpx; }
.starter-companions > view { display: flex; align-items: center; min-width: 0; padding: 18rpx; border: 1rpx solid #dfebf8; border-radius: 24rpx; background: rgba(255,255,255,.82); }
.starter-companion-emoji { flex: 0 0 auto; margin-right: 12rpx; font-size: 40rpx; }
.starter-companion-name, .starter-companion-line { display: block; }
.starter-companion-name { color: #284b75; font-size: 23rpx; font-weight: 700; }
.starter-companion-line { margin-top: 5rpx; color: #7b8fa7; font-size: 19rpx; line-height: 1.45; }
.starter-choice-title { margin-top: 32rpx; color: #456889; font-size: 23rpx; font-weight: 700; }
.starter-choice-scroll { width: 100%; margin-top: 14rpx; white-space: nowrap; }
.starter-choice-row { display: inline-flex; gap: 16rpx; padding: 2rpx 2rpx 14rpx; }
.starter-choice { position: relative; width: 192rpx; padding: 10rpx 10rpx 16rpx; border: 2rpx solid transparent; border-radius: 24rpx; background: #f0f6fc; color: #536f8f; font-size: 22rpx; text-align: center; }
.starter-choice-active { border-color: #4c91e5; background: #fff; box-shadow: 0 10rpx 28rpx rgba(53, 116, 188, .15); color: #245e9f; font-weight: 700; }
.starter-choice image, .starter-choice-placeholder { width: 172rpx; height: 126rpx; margin-bottom: 10rpx; border-radius: 17rpx; background: #e5f1fd; }
.starter-choice-placeholder { display: flex; align-items: center; justify-content: center; font-size: 48rpx; }
.starter-choice-recommended { position: absolute; right: 5rpx; top: 5rpx; padding: 5rpx 10rpx; border-radius: 999rpx; background: #e9f3ff; color: #347bc9; font-size: 16rpx; }
.starter-error { margin-top: 16rpx; color: #bd4c55; font-size: 22rpx; text-align: center; }
.starter-claim-button, .starter-tree-button { height: 94rpx; margin-top: 22rpx; border-radius: 28rpx; font-size: 29rpx; font-weight: 700; line-height: 94rpx; }
.starter-claim-button { position: sticky; z-index: 5; bottom: 0; }
.starter-claim-button { color: #fff; background: linear-gradient(110deg, #347ed8, #5aa8ef); box-shadow: 0 16rpx 34rpx rgba(45, 121, 207, .24); }
.starter-tree-button { margin-top: 14rpx; color: #326fab; background: #edf5fd; }
.starter-reveal-footnote { margin: 20rpx 0 10rpx; color: #92a2b5; font-size: 19rpx; line-height: 1.6; text-align: center; }
.starter-share-canvas { position: fixed; left: -3000px; top: 0; width: 500px; height: 400px; pointer-events: none; }
.eyebrow {
  color: #65796d;
  font-size: 24rpx;
  margin: 0 4rpx 24rpx;
  letter-spacing: 2rpx;
}
.result-header,
.content-card,
.state-card {
  background: #fffdf8;
  border: 1rpx solid #ede9dc;
  border-radius: 36rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 10rpx 32rpx rgba(38, 66, 45, 0.04);
}
.result-header {
  text-align: center;
}
.priority-order-card { margin-bottom: 28rpx; padding: 31rpx 22rpx 28rpx; overflow: hidden; border: 1rpx solid #dfe9fa; border-radius: 34rpx; background: radial-gradient(circle at 90% 0, #eee9ff, transparent 42%), linear-gradient(160deg, #fafdff, #eef6ff); box-shadow: 0 14rpx 38rpx rgba(65, 105, 166, .09); }
.priority-order-kicker { color: #829bc0; font-size: 18rpx; letter-spacing: 2rpx; }
.priority-order-title { margin-top: 11rpx; color: #244c7f; font-size: 34rpx; font-weight: 750; }
.priority-order-subtitle { margin-top: 7rpx; color: #7d93b2; font-size: 21rpx; line-height: 1.6; }
.priority-order-scroll { width: 100%; }
.priority-order-grid { display: grid; gap: 4rpx; margin: 24rpx auto 0; }
.priority-order-item { position: relative; min-width: 0; text-align: center; }
.priority-order-visual { position: relative; width: 92rpx; height: 92rpx; margin: 0 auto; border: 1rpx solid #dce8f9; border-radius: 25rpx; background: #fff; box-shadow: 0 7rpx 18rpx rgba(75, 117, 177, .1); }
.priority-order-visual image { width: 100%; height: 100%; border-radius: inherit; }
.priority-order-placeholder { display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; border-radius: inherit; color: #9db9e3; background: linear-gradient(145deg, #edf5ff, #f2efff); font-size: 31rpx; }
.priority-order-visual text { position: absolute; right: -5rpx; top: -7rpx; display: flex; align-items: center; justify-content: center; width: 31rpx; height: 31rpx; border-radius: 50%; color: #fff; background: linear-gradient(135deg, #6ab2ff, #7b7eea); font-size: 17rpx; font-weight: 800; box-shadow: 0 5rpx 13rpx rgba(74, 111, 198, .22); }
.priority-order-label { margin-top: 11rpx; color: #4d6f9c; font-size: 18rpx; line-height: 1.35; }
.priority-order-arrow { position: absolute; z-index: 2; top: 34rpx; right: -9rpx; color: #a7bada; font-size: 20rpx; }
.priority-order-insight { margin-top: 24rpx; padding: 20rpx; border-radius: 22rpx; color: #315f99; background: rgba(255,255,255,.76); font-size: 23rpx; font-weight: 650; line-height: 1.55; }
.priority-order-insight text { display: block; margin-top: 5rpx; color: #7c8fa8; font-size: 20rpx; font-weight: 400; }
.result-icon {
  margin: 0 auto 24rpx;
  width: 136rpx;
  height: 136rpx;
  line-height: 136rpx;
  font-size: 72rpx;
  background: #edf3e5;
  border-radius: 50%;
}
.result-image {
  display: block;
  width: 360rpx;
  height: 360rpx;
  margin: 0 auto 28rpx;
  border-radius: 24rpx;
}
.result-type {
  font-size: 48rpx;
  color: #174a37;
  font-weight: 700;
}
.result-code {
  color: #71846f;
  font-size: 26rpx;
  margin-top: 10rpx;
  letter-spacing: 3rpx;
}
.result-summary {
  font-size: 29rpx;
  line-height: 1.8;
  margin: 24rpx 0;
  color: #4f635b;
}
.saved-badge {
  display: inline-block;
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
  background: #edf4e4;
  color: #47664c;
  font-size: 22rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.report-tier-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 8rpx 16rpx;
  color: #778178;
  font-size: 22rpx;
}
.report-tier-label text:first-child {
  color: #315944;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.basic-report-card {
  border-top: 6rpx solid #dbe8d0;
}
.body-copy {
  font-size: 28rpx;
  color: #53645c;
  line-height: 1.9;
}
.advice-box {
  background: #f4edd9;
  padding: 28rpx;
  border-radius: 24rpx;
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #756039;
  line-height: 1.85;
}
.advice-label {
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.report-note,
.local-note {
  font-size: 23rpx;
  color: #7b8379;
  line-height: 1.8;
  margin-top: 24rpx;
}
.local-note {
  padding: 0 8rpx;
  margin-bottom: 28rpx;
}
.legacy-note {
  padding: 24rpx;
  background: #fff0d0;
  border-radius: 20rpx;
  font-size: 24rpx;
  line-height: 1.7;
  margin-bottom: 24rpx;
  color: #806231;
}
.dimension {
  margin-top: 32rpx;
}
.dimension-heading {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 25rpx;
  color: #3d5c48;
}
.dimension-track {
  height: 14rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #e8eddf;
  margin: 16rpx 0;
}
.dimension-fill {
  height: 100%;
  border-radius: 8rpx;
  background: #6f9c70;
}
.dimension-summary {
  font-size: 24rpx;
  line-height: 1.7;
  color: #73806e;
}
.archive-link {
  padding: 32rpx;
  border-radius: 28rpx;
  background: #e6efd9;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.archive-title {
  font-size: 29rpx;
  color: #24513d;
  font-weight: 600;
}
.archive-subtitle {
  color: #708267;
  font-size: 23rpx;
  margin-top: 10rpx;
}
.archive-arrow {
  color: #345c41;
  font-size: 40rpx;
}
.result-actions {
  display: flex;
  gap: 20rpx;
}
.result-actions button {
  flex: 1;
}
.primary-button,
.secondary-button {
  font-size: 28rpx;
  line-height: 1.5;
  padding: 25rpx 24rpx;
  border-radius: 48rpx;
  margin: 0;
  font-weight: 600;
}
.primary-button {
  background: #205c42;
  color: #fffdf4;
}
.secondary-button {
  background: #fffdf7;
  border: 1rpx solid #d9e1cc;
  color: #466344;
}
button::after {
  border: 0;
}
.text-button {
  background: transparent;
  font-size: 26rpx;
  color: #50704e;
  margin: 16rpx 0 0;
  padding: 10rpx;
}
.muted {
  color: #879080;
  font-size: 24rpx;
}
.state-card {
  margin-top: 60rpx;
  text-align: center;
  padding: 60rpx 32rpx;
}
.state-leaf {
  color: #789b65;
  font-size: 80rpx;
}
.state-title {
  font-size: 38rpx;
  margin: 28rpx 0 20rpx;
  font-weight: 600;
}
.state-copy {
  color: #74806f;
  font-size: 28rpx;
  line-height: 1.9;
  margin-bottom: 40rpx;
}
.pressed {
  opacity: 0.8;
}
.premium-lock-card,
.premium-report-header,
.premium-section {
  border: 1rpx solid rgba(181, 139, 57, 0.28);
  border-radius: 32rpx;
  background: linear-gradient(145deg, #1e352e, #142a25);
  color: #fff9e9;
  box-shadow: 0 18rpx 50rpx rgba(28, 45, 38, 0.12);
}
.premium-lock-card {
  padding: 38rpx 30rpx 32rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
  position: relative;
}
.premium-lock-card::before {
  content: '';
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  right: -100rpx;
  top: -120rpx;
  background: radial-gradient(circle, rgba(223, 184, 97, 0.22), transparent 70%);
}
.premium-kicker {
  color: #e7c978;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.premium-crown {
  margin-right: 10rpx;
}
.premium-title {
  font-family: Georgia, 'Songti SC', serif;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.45;
  margin-top: 18rpx;
  color: #fff9e9;
}
.premium-subtitle {
  color: #c8d3c8;
  font-size: 25rpx;
  line-height: 1.75;
  margin-top: 12rpx;
}
.premium-preview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin: 28rpx 0;
}
.premium-preview-grid view {
  padding: 20rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(234, 211, 150, 0.16);
  background: rgba(255, 255, 255, 0.05);
}
.premium-preview-grid text {
  display: block;
}
.premium-preview-grid text:first-child {
  color: #f3dfaa;
  font-size: 24rpx;
  font-weight: 600;
}
.premium-preview-grid text:last-child {
  color: #aebbb1;
  font-size: 20rpx;
  margin-top: 6rpx;
}
.premium-unlock-button {
  margin: 0;
  border: 0;
  border-radius: 48rpx;
  color: #21372f;
  background: linear-gradient(90deg, #f3d789, #e5b95d);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.5;
  padding: 24rpx 20rpx;
}
.premium-unlock-button[disabled] {
  opacity: 0.72;
}
.premium-rule,
.premium-unlocked-at {
  text-align: center;
  color: #95a49a;
  font-size: 19rpx;
  line-height: 1.6;
  margin-top: 18rpx;
}
.ad-error {
  color: #f0bd9d;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
  margin-top: 14rpx;
}
.premium-report {
  margin-bottom: 30rpx;
}
.premium-report-header {
  padding: 38rpx 30rpx;
  text-align: center;
  border-radius: 32rpx 32rpx 0 0;
}
.premium-report-header .premium-kicker {
  text-align: left;
}
.premium-section {
  padding: 36rpx 30rpx;
  border-radius: 0;
  border-top: 0;
  box-shadow: none;
  background: #fffdf8;
  color: #243b32;
}
.premium-section:last-of-type {
  border-radius: 0 0 32rpx 32rpx;
}
.premium-section-title {
  font-family: Georgia, 'Songti SC', serif;
  color: #244839;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
}
.deep-dimension {
  padding: 24rpx 0;
  border-top: 1rpx solid #eee8d9;
}
.deep-dimension:first-of-type {
  border-top: 0;
  padding-top: 0;
}
.deep-dimension-heading,
.deep-poles {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.deep-dimension-heading {
  color: #2e5041;
  font-size: 26rpx;
  font-weight: 600;
}
.deep-dimension-heading text:last-child {
  color: #b18841;
  font-family: Georgia, serif;
}
.deep-poles {
  color: #879188;
  font-size: 20rpx;
  margin-top: 14rpx;
}
.deep-track {
  height: 16rpx;
  border-radius: 8rpx;
  background: #e8eadf;
  position: relative;
  margin: 12rpx 5rpx 18rpx;
}
.deep-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #99ad86, #d2ad5d);
}
.deep-midline {
  position: absolute;
  left: 50%;
  top: -5rpx;
  width: 2rpx;
  height: 26rpx;
  background: #fffdf8;
  z-index: 2;
}
.deep-dot {
  position: absolute;
  top: 50%;
  width: 22rpx;
  height: 22rpx;
  margin: -11rpx 0 0 -11rpx;
  border-radius: 50%;
  background: #b78c3b;
  border: 4rpx solid #fffdf8;
  box-shadow: 0 2rpx 8rpx rgba(88, 67, 31, 0.24);
  z-index: 3;
}
.deep-detail {
  color: #707c73;
  font-size: 23rpx;
  line-height: 1.7;
}
.insight-section {
  background: #f5f3e9;
}
.insight-card {
  display: grid;
  grid-template-columns: 54rpx 1fr;
  gap: 18rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #e4e0d2;
}
.insight-card:first-of-type {
  border-top: 0;
  padding-top: 0;
}
.insight-index {
  color: #c2a05c;
  font-family: Georgia, serif;
  font-size: 23rpx;
  padding-top: 4rpx;
}
.insight-title {
  color: #2a493c;
  font-size: 27rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.insight-content {
  color: #657269;
  font-size: 24rpx;
  line-height: 1.85;
}
.action-section {
  background: #fffaf0;
}
.action-item {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  color: #56665e;
  font-size: 24rpx;
  line-height: 1.75;
  margin-top: 18rpx;
}
.action-item text {
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  color: #fff9e9;
  background: #486b58;
  font-size: 20rpx;
}
.premium-note {
  color: #8a9188;
  font-size: 21rpx;
  line-height: 1.7;
  padding: 22rpx 26rpx;
  text-align: center;
}
.premium-save-banner {
  padding: 28rpx;
  background: #fff0cc;
  border-left: 1rpx solid #dccb9e;
  border-right: 1rpx solid #dccb9e;
}
.premium-save-title {
  color: #6f582d;
  font-size: 26rpx;
  font-weight: 600;
}
.premium-save-copy {
  margin: 12rpx 0 22rpx;
  color: #8b744c;
  font-size: 23rpx;
  line-height: 1.7;
}
.premium-save-button {
  margin: 0;
  padding: 18rpx;
  color: #fffdf4;
  background: #486b58;
  border-radius: 36rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.comparison-card { margin:24rpx 0; padding:29rpx; border:1rpx solid #c9defb; border-radius:30rpx; background:linear-gradient(150deg,#f7fbff,#e8f3ff); box-shadow:0 13rpx 32rpx #6e9ed21a; }.comparison-kicker { color:#6590c8; font-size:20rpx; letter-spacing:2rpx; }.comparison-kicker text { color:#3c7ed9; }.comparison-title { margin-top:13rpx; color:#214f88; font-size:32rpx; font-weight:700; line-height:1.5; }.comparison-context { display:flex; align-items:center; gap:12rpx; margin-top:16rpx; color:#6f8eb5; font-size:21rpx; }.comparison-context text:first-child,.comparison-context text:last-child { padding:7rpx 13rpx; border-radius:18rpx; background:#ffffffc9; }.comparison-headline { margin-top:20rpx; color:#476d9c; font-size:25rpx; line-height:1.8; }.comparison-list { margin-top:18rpx; }.comparison-row { display:flex; justify-content:space-between; align-items:center; gap:20rpx; padding:17rpx 0; border-top:1rpx solid #dbe8f8; }.comparison-row > view:first-child text { display:block; }.comparison-row > view:first-child text:first-child { color:#355d8e; font-size:24rpx; }.comparison-row > view:first-child text:last-child { margin-top:5rpx; color:#8298b4; font-size:19rpx; }.comparison-delta { flex:none; min-width:83rpx; text-align:right; color:#758ca9; font-size:27rpx; font-weight:700; }.delta-up { color:#4383d5; }.delta-down { color:#8b78ba; }.comparison-note { margin-top:9rpx; color:#8295ad; font-size:19rpx; line-height:1.7; }.comparison-share { min-height:82rpx; margin:22rpx 0 0; border:1rpx solid #bed7f7; border-radius:41rpx; color:#3975bd; background:#ffffffc7; font-size:23rpx; }.comparison-share::after { border:0; }.premium-comparison { margin-top:20rpx; padding:20rpx; border:1rpx solid #d9e8fd; border-radius:22rpx; background:#f7fbff; }.premium-change { display:grid; grid-template-columns:1fr auto auto; gap:15rpx; padding:14rpx 0; border-bottom:1rpx solid #e4eefb; color:#57799f; font-size:19rpx; }.premium-change text:last-child { min-width:62rpx; text-align:right; color:#3f7bc3; font-weight:650; }.premium-reflection { margin-top:16rpx; color:#647f9f; font-size:20rpx; line-height:1.75; }

/* Keep primary report actions comfortably tappable on narrow phones. */
.result-page .premium-unlock-button,
.result-page .premium-tab,
.result-page .primary-button,
.result-page .secondary-button,
.result-page .text-button { min-height: 44px; }
