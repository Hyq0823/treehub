:host {
  display: block;
}
.tree-art {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  margin: auto;
  isolation: isolate;
}
.tree-art--large {
  width: 440rpx;
  height: 440rpx;
}
.tree-art--small {
  width: 150rpx;
  height: 150rpx;
}
.tree-halo {
  position: absolute;
  inset: 12%;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(238, 209, 124, 0.3),
    rgba(226, 237, 212, 0.2) 60%,
    transparent 72%
  );
}
.tree-shape,
.sprite-window,
.growth-shape,
.growth-window {
  position: absolute;
  inset: 0;
}
.tree-shape {
  transform-origin: 50% 90%;
}
.sprite-window {
  overflow: hidden;
}
.tree-sprite {
  position: absolute;
  width: 300%;
  height: 200%;
  max-width: none;
}
.growth-window {
  overflow: hidden;
}
.growth-sprite {
  position: absolute;
  width: 200%;
  height: 200%;
  max-width: none;
}
.growth-shape {
  transform: scale(0.94);
  transform-origin: 50% 88%;
  filter: drop-shadow(0 12rpx 12rpx rgba(70, 60, 36, 0.08));
}
.ground-shadow {
  position: absolute;
  bottom: 9%;
  left: 24%;
  width: 52%;
  height: 6%;
  border-radius: 50%;
  background: rgba(40, 74, 48, 0.07);
  z-index: -1;
}
.tree-spark {
  position: absolute;
  color: #d2aa4d;
  font-size: 14rpx;
  opacity: 0.82;
  text-shadow: 0 2rpx 8rpx rgba(169, 126, 36, 0.2);
}
.stage-seed .tree-spark {
  opacity: 0.25;
}
.stage-starlight .tree-halo {
  box-shadow: 0 0 45rpx #eed893;
}
.stage-blossom .tree-spark {
  color: #dba5a3;
}
.seed-scene,
.sapling {
  position: absolute;
  inset: 0;
}
.soil {
  position: absolute;
  bottom: 14%;
  left: 25%;
  height: 9%;
  width: 50%;
  border-radius: 50%;
  background: #bba581;
  box-shadow: 0 8rpx 20rpx #46592e15;
}
.seed {
  position: absolute;
  width: 18%;
  height: 27%;
  left: 42%;
  bottom: 20%;
  border-radius: 65% 35% 65% 35%;
  transform: rotate(-25deg);
  background: linear-gradient(110deg, #a27a49, #d4b581);
}
.seed-spark {
  position: absolute;
  left: 66%;
  top: 29%;
  color: #bc993c;
  font-size: 40rpx;
}
.stem {
  position: absolute;
  left: 49%;
  bottom: 20%;
  height: 39%;
  width: 3%;
  background: linear-gradient(#8ba565, #466740);
  border-radius: 50%;
}
.leaf {
  position: absolute;
  width: 28%;
  height: 18%;
  background: linear-gradient(145deg, #a9c878, #3c7c53);
  border-radius: 85% 0 85% 0;
}
.leaf-left {
  left: 23%;
  top: 34%;
  transform: rotate(54deg);
}
.leaf-right {
  left: 49%;
  top: 27%;
  transform: rotate(-12deg);
}
.sapling-rooted .stem {
  height: 57%;
  background: linear-gradient(#8ca76a, #82663e);
}
.sapling-rooted .leaf-left {
  top: 44%;
}
.sapling-rooted .leaf-right {
  top: 34%;
}
.leaf-upper {
  left: 31%;
  top: 18%;
  width: 21%;
  height: 15%;
  transform: rotate(54deg);
}
.leaf-lower {
  left: 48%;
  top: 56%;
  width: 22%;
  height: 15%;
  transform: rotate(-10deg);
}
