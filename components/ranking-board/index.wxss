.rank-board { display: block; color: #294e81; }
.rank-helper { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin: 24rpx 2rpx 20rpx; }
.rank-helper-copy { color: #6985aa; font-size: 22rpx; line-height: 1.55; }
.rank-helper-count { flex: 0 0 auto; min-width: 70rpx; padding: 9rpx 15rpx; border: 1rpx solid #d5e5fb; border-radius: 999rpx; background: #f4f8ff; color: #5385cc; font-size: 20rpx; font-weight: 700; text-align: center; }
.rank-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.rank-card { position: relative; min-width: 0; min-height: 310rpx; padding: 18rpx 17rpx 20rpx; border: 2rpx solid #e3edfb; border-radius: 26rpx; background: linear-gradient(155deg, #fff 0%, #f8fbff 68%, #f4f1ff 100%); box-shadow: 0 13rpx 32rpx rgba(83, 122, 176, .09); overflow: hidden; transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease, background .2s ease; box-sizing: border-box; }
.rank-card-wide { grid-column: 1 / -1; min-height: 250rpx; display: grid; grid-template-columns: 230rpx 1fr; grid-template-rows: 1fr auto; align-items: center; column-gap: 16rpx; }
.rank-card-pressed { transform: scale(.975); }
.rank-card-selected { border-color: #7faef4; background: linear-gradient(150deg, #f6faff, #eef4ff 56%, #f3efff); box-shadow: 0 16rpx 38rpx rgba(68, 122, 211, .16), inset 0 0 0 3rpx rgba(255, 255, 255, .72); transform: translateY(-3rpx); }
.rank-card-light { position: absolute; width: 140rpx; height: 140rpx; top: -75rpx; right: -45rpx; border-radius: 50%; background: rgba(203, 218, 255, .38); filter: blur(4rpx); }
.rank-image { position: relative; display: block; width: 100%; height: 180rpx; margin: 0 auto 8rpx; }
.rank-card-wide .rank-image { grid-row: 1 / 3; width: 220rpx; height: 220rpx; margin: 0; }
.rank-card-title { position: relative; color: #284b78; font-size: 26rpx; font-weight: 700; line-height: 1.48; }
.rank-card-state { position: relative; margin-top: 8rpx; color: #9aaac0; font-size: 20rpx; line-height: 1.4; }
.rank-card-selected .rank-card-state { color: #668ac1; }
.rank-badge { position: absolute; z-index: 3; top: 14rpx; left: 14rpx; display: flex; align-items: center; gap: 7rpx; padding: 6rpx 11rpx 6rpx 7rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .94); color: #3f73bf; box-shadow: 0 7rpx 20rpx rgba(47, 100, 176, .16); animation: rankBadgeIn .22s ease both; }
.rank-badge-number { display: flex; align-items: center; justify-content: center; width: 31rpx; height: 31rpx; border-radius: 50%; background: linear-gradient(135deg, #6db5ff, #7c82ed); color: #fff; font-size: 18rpx; font-weight: 800; }
.rank-badge-copy { font-size: 17rpx; font-weight: 700; }
.rank-tray { position: relative; z-index: 8; height: 250rpx; margin: 22rpx -4rpx -4rpx; padding: 19rpx 20rpx 15rpx; border: 1rpx solid rgba(204, 222, 247, .88); border-radius: 25rpx; background: rgba(249, 252, 255, .96); box-shadow: 0 -10rpx 35rpx rgba(72, 111, 165, .09); backdrop-filter: blur(18rpx); box-sizing: border-box; }
.rank-tray-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.rank-tray-kicker { display: block; color: #a6b9d4; font-size: 14rpx; letter-spacing: 2rpx; }
.rank-tray-title { display: block; margin-top: 3rpx; color: #365d91; font-size: 21rpx; font-weight: 750; }
.rank-tray-actions { display: flex; gap: 9rpx; }
.rank-action { min-width: 104rpx; min-height: 104rpx; padding: 0 13rpx; border-radius: 999rpx; background: #eaf2ff; color: #527db9; font-size: 18rpx; line-height: 104rpx; text-align: center; box-sizing: border-box; }
.rank-action-disabled { opacity: .42; }
.rank-order-row { display: flex; align-items: center; gap: 8rpx; height: 70rpx; margin-top: 12rpx; overflow-x: auto; white-space: nowrap; }
.rank-order-chip { flex: 0 0 auto; display: flex; align-items: center; max-width: 166rpx; height: 51rpx; padding: 0 12rpx 0 7rpx; border-radius: 999rpx; background: linear-gradient(120deg, #e9f3ff, #f0edff); color: #466eaa; box-sizing: border-box; animation: rankChipIn .2s ease both; }
.rank-order-number { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; margin-right: 7rpx; border-radius: 50%; background: #6a94dc; color: #fff; font-size: 17rpx; font-weight: 800; }
.rank-order-name { overflow: hidden; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.rank-order-empty { display: flex; align-items: center; height: 70rpx; margin-top: 12rpx; color: #a8b9cf; }
.rank-order-slot { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; border: 1rpx dashed #c7d6e9; border-radius: 50%; font-size: 16rpx; }
.rank-order-link { flex: 1; height: 1rpx; min-width: 12rpx; background: #dde7f4; }
.rank-complete-copy { height: 30rpx; color: #587fb8; font-size: 18rpx; line-height: 30rpx; text-align: center; opacity: 0; transform: translateY(4rpx); transition: opacity .2s ease, transform .2s ease; }
.rank-complete-copy-visible { opacity: 1; transform: translateY(0); }
.rank-board-complete .rank-card { pointer-events: none; }
.rank-retry { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 16rpx; padding: 18rpx 20rpx; border: 1rpx solid #f2d8ae; border-radius: 22rpx; color: #956f38; background: #fff8e9; font-size: 20rpx; line-height: 1.5; }
.rank-retry-button { flex: 0 0 auto; min-height: 104rpx; padding: 0 22rpx; border-radius: 999rpx; color: #fff; background: linear-gradient(110deg, #69adff, #477fed); font-size: 21rpx; font-weight: 700; line-height: 104rpx; }
@keyframes rankBadgeIn { from { opacity: 0; transform: scale(.72); } to { opacity: 1; transform: scale(1); } }
@keyframes rankChipIn { from { opacity: 0; transform: translateX(10rpx); } to { opacity: 1; transform: translateX(0); } }
