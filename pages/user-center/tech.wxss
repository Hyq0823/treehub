.archive-page { position: relative; min-height: 100vh; color: #eafff9; background: radial-gradient(circle at 90% 4%, rgba(105,87,226,.15), transparent 25%), radial-gradient(circle at 8% 30%, rgba(65,218,186,.1), transparent 27%), linear-gradient(160deg, #071720, #06111b 58%, #091723); overflow: hidden; }
.archive-page::before { content: ''; position: fixed; inset: 0; pointer-events: none; opacity: .2; background-image: linear-gradient(rgba(99,235,210,.07) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(99,235,210,.07) 1rpx, transparent 1rpx); background-size: 54rpx 54rpx; mask-image: linear-gradient(to bottom, #000, transparent 72%); }
.archive-page > view, .archive-page > block { position: relative; z-index: 1; }
.archive-page .eyebrow { color: #62d9c0; }.archive-page .page-title { color: #f0fffb; }.archive-page .page-subtitle { color: #789499; }
.archive-page .tree-panel { position: relative; border-color: rgba(100,237,209,.25); background: radial-gradient(circle at 50% 40%, rgba(73,229,194,.13), transparent 38%), linear-gradient(145deg, rgba(15,42,51,.96), rgba(8,27,38,.94)); box-shadow: 0 28rpx 75rpx rgba(0,0,0,.32), inset 0 1rpx rgba(255,255,255,.07); animation: archiveRise .55s ease; }
.archive-page .tree-panel::before { content: ''; position: absolute; inset: 0; opacity: .2; background: repeating-linear-gradient(0deg, transparent 0 34rpx, rgba(105,238,212,.08) 35rpx 36rpx); pointer-events: none; }
.archive-page .tree-caption { color: #61dfc2; letter-spacing: 3rpx; }.archive-page .stage-badge { color: #08201f; background: linear-gradient(100deg, #62e5c6, #d6ca70); box-shadow: 0 0 22rpx rgba(91,226,196,.2); }
.archive-page .tree-name { color: #f0fffb; }.archive-page .tree-meaning { color: #d6c672; }.archive-page .tree-story { color: #91aaa6; }.archive-page .tree-panel-bottom { border-color: rgba(111,181,177,.16); color: #66e5c7; }.archive-page .tree-panel-bottom text:last-child { color: #78969a; }
.archive-page .stats-panel { margin-top: 18rpx; padding: 24rpx 10rpx; border: 1rpx solid rgba(103,171,171,.15); border-radius: 24rpx; background: rgba(11,32,42,.78); }
.archive-page .stat { border-color: rgba(108,169,168,.15); }.archive-page .stat-number { color: #72e9cd; text-shadow: 0 0 18rpx rgba(90,229,199,.18); }.archive-page .stat-number text, .archive-page .stat-label { color: #708c90; }
.archive-page .growth-panel, .archive-page .evidence-panel { border-color: rgba(102,178,173,.16); background: linear-gradient(145deg, rgba(14,37,48,.94), rgba(9,28,39,.92)); box-shadow: 0 16rpx 42rpx rgba(0,0,0,.2); }
.archive-page .section-title { color: #e9faf6; }.archive-page .section-aside { color: #6d898e; }
.archive-page .growth-track { background: #15333b; }.archive-page .growth-fill { position: relative; background: linear-gradient(90deg, #4bd4b5, #73edcd, #d4c36c); box-shadow: 0 0 18rpx rgba(82,225,193,.35); }.archive-page .growth-hint { color: #829b9b; }.archive-page .growth-hint text { color: #6ce4c8; }
.archive-page .stage-item { color: #58767b; }.archive-page .stage-dot { color: #5a777a; border-color: #284951; background: #0c2934; }.archive-page .stage-reached .stage-dot { color: #08201e; border-color: #64e5c7; background: linear-gradient(135deg, #61e2c4, #d5c56d); box-shadow: 0 0 18rpx rgba(91,227,197,.24); animation: stagePulse 2.2s ease-in-out infinite alternate; }.archive-page .stage-reached .stage-name { color: #70e2c8; }.archive-page .stage-planned { color: #425d63; }
.archive-page .footnote { color: #58757a; }.archive-page .evidence-line { color: #819b98; }.archive-page .evidence-dot { color: #d4c16c; }
.archive-page .record-group { border-color: rgba(103,173,171,.16); background: linear-gradient(145deg, rgba(14,37,48,.95), rgba(8,28,39,.93)); box-shadow: 0 14rpx 38rpx rgba(0,0,0,.18); }
.archive-page .group-name { color: #e8faf5; }.archive-page .record-count { color: #6fe3c8; background: rgba(91,225,194,.1); }.archive-page .latest-label, .archive-page .record-date { color: #668388; }.archive-page .latest-title { color: #b7ece0; }.archive-page .record-arrow { color: #66e0c5; }
.archive-page .premium-history-badge { color: #e7cf7d; background: rgba(221,195,104,.11); }.archive-page .group-actions { border-color: rgba(105,169,167,.13); }.archive-page .text-action { color: #65dfc3; }.archive-page .muted-action { color: #6b878b; }.archive-page .record-history { border-color: rgba(105,169,167,.13); background: rgba(5,22,31,.52); }.archive-page .history-row { border-color: rgba(105,169,167,.12); }.archive-page .history-title { color: #a9c9c3; }
.archive-page .empty-panel { color: #91aaa6; border-color: rgba(103,190,179,.22); background: rgba(12,34,44,.84); }.archive-page .empty-symbol { color: #d7c66e; background: rgba(216,197,105,.1); }.archive-page .empty-title { color: #e8faf6; }.archive-page .body-copy { color: #789398; }
.archive-page .primary-action { color: #08201e; background: linear-gradient(100deg, #62e3c4, #b6e6a8); }.archive-page .explore-more { color: #65dfc3; border-color: rgba(95,221,196,.28); background: rgba(12,34,44,.7); }
.archive-page .cloud-note { color: #729093; border-color: rgba(104,185,178,.17); background: rgba(12,34,44,.78); }.archive-page .cloud-note-title { color: #65dfc2; }.archive-page .cloud-synced .cloud-note-title { color: #70e6c9; }.archive-page .cloud-pending { border-color: rgba(218,190,94,.22); background: rgba(69,55,25,.35); }.archive-page .cloud-retry { color: #08201e; background: #69dfc3; }
@keyframes archiveRise { from { opacity: 0; transform: translateY(25rpx); } to { opacity: 1; transform: none; } }
@keyframes stagePulse { from { transform: scale(.94); } to { transform: scale(1.05); } }
