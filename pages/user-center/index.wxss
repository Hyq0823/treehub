page {
  background: #faf7ef;
  color: #152d3c;
}
.archive-page {
  padding: 38rpx 32rpx 64rpx;
}
.eyebrow {
  color: #758875;
  font-size: 20rpx;
  letter-spacing: 5rpx;
}
.page-title {
  margin-top: 10rpx;
  font-size: 50rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.page-subtitle {
  margin: 14rpx 0 32rpx;
  color: #778179;
  font-size: 25rpx;
  line-height: 1.6;
}
.tree-panel {
  background: linear-gradient(155deg, #eef3df, #f6f8ec 64%, #e7efda);
  border: 1rpx solid #e0e7d2;
  border-radius: 32rpx;
  padding: 28rpx 28rpx 0;
  text-align: center;
  overflow: hidden;
}
.tree-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.tree-caption {
  color: #5e7462;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}
.stage-badge {
  padding: 7rpx 20rpx;
  color: #2c6249;
  background: #dce9cc;
  border-radius: 30rpx;
  font-size: 22rpx;
}
.tree-name {
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 6rpx;
}
.tree-meaning {
  color: #657954;
  margin-top: 12rpx;
  font-size: 26rpx;
  letter-spacing: 3rpx;
}
.tree-story {
  color: #53675d;
  font-size: 26rpx;
  line-height: 1.9;
  margin: 22rpx 6rpx 30rpx;
  text-align: left;
}
.tree-panel-bottom {
  border-top: 1rpx solid #dce5d1;
  padding: 23rpx 0;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 24rpx;
  color: #326349;
}
.tree-panel-bottom text:last-child {
  font-size: 22rpx;
  color: #6f8468;
}
.stats-panel {
  display: flex;
  padding: 30rpx 0;
  margin-bottom: 8rpx;
}
.stat {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #dedfd2;
}
.stat:last-child {
  border-right: 0;
}
.stat-number {
  color: #255d45;
  font-size: 42rpx;
  font-weight: 600;
}
.stat-number text {
  font-size: 24rpx;
  font-weight: 400;
  color: #929a8b;
}
.stat-label {
  font-size: 22rpx;
  color: #7a8176;
  margin-top: 6rpx;
}
.growth-panel,
.evidence-panel {
  border-radius: 26rpx;
  background: #fffdf7;
  border: 1rpx solid #ebe8dc;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
}
.section-aside {
  color: #8c9286;
  font-size: 21rpx;
}
.growth-track {
  background: #e8ebdf;
  height: 10rpx;
  border-radius: 10rpx;
  overflow: hidden;
  margin: 26rpx 0 20rpx;
}
.growth-fill {
  height: 100%;
  background: #56876a;
  border-radius: 10rpx;
}
.growth-hint {
  font-size: 24rpx;
  line-height: 1.7;
  color: #6f7b6b;
}
.growth-hint text {
  color: #236246;
  font-weight: 600;
}
.stage-scroll {
  white-space: nowrap;
  width: 100%;
  margin: 24rpx 0 16rpx;
}
.stage-list {
  display: inline-flex;
  min-width: 100%;
}
.stage-item {
  width: 108rpx;
  flex-shrink: 0;
  text-align: center;
  color: #86917f;
}
.stage-dot {
  border-radius: 50%;
  margin: 0 auto 12rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 46rpx;
  border: 1rpx solid #d9dfcf;
  background: #f3f3e9;
  font-size: 30rpx;
}
.stage-name {
  font-size: 23rpx;
}
.stage-threshold {
  font-size: 20rpx;
  margin-top: 7rpx;
}
.stage-reached .stage-dot {
  background: #376d4d;
  color: #fff8dd;
  border-color: #376d4d;
}
.stage-reached .stage-name {
  color: #265e42;
  font-weight: 600;
}
.stage-planned {
  color: #a2a69d;
}
.stage-later {
  font-size: 17rpx;
  margin-top: 6rpx;
}
.footnote {
  margin-top: 16rpx;
  font-size: 21rpx;
  color: #929789;
  line-height: 1.7;
  white-space: normal;
}
.evidence-line {
  display: flex;
  gap: 12rpx;
  color: #647060;
  font-size: 24rpx;
  line-height: 1.8;
  margin-top: 16rpx;
}
.evidence-dot {
  color: #b29753;
  font-size: 30rpx;
}
.records-heading {
  margin: 36rpx 0 22rpx;
}
.record-group {
  border-radius: 26rpx;
  border: 1rpx solid #e6e7da;
  background: #fffdf8;
  margin-bottom: 22rpx;
  overflow: hidden;
}
.group-heading {
  padding: 26rpx 26rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}
.group-name {
  font-size: 28rpx;
  font-weight: 600;
}
.record-count {
  color: #74836c;
  background: #edf1e5;
  border-radius: 20rpx;
  padding: 5rpx 15rpx;
  font-size: 20rpx;
  flex-shrink: 0;
}
.latest-record {
  padding: 25rpx 26rpx 20rpx;
}
.latest-label {
  color: #999e91;
  font-size: 21rpx;
}
.latest-title {
  color: #2c5f44;
  font-size: 31rpx;
  font-weight: 600;
  margin: 9rpx 0 12rpx;
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}
.record-date {
  color: #8d9588;
  font-size: 21rpx;
  line-height: 1.6;
}
.record-arrow {
  font-size: 28rpx;
  color: #7b967e;
}
.group-actions {
  display: flex;
  justify-content: space-between;
  margin: 0 26rpx;
  padding: 12rpx 0 18rpx;
  border-top: 1rpx solid #eeeee5;
}
button {
  margin: 0;
}
button::after {
  border: 0;
}
.text-action {
  background: transparent;
  color: #286342;
  font-size: 24rpx;
  line-height: 1.8;
  padding: 8rpx 0;
  border-radius: 0;
}
.muted-action {
  color: #858f7d;
}
.record-history {
  border-top: 1rpx solid #eeeee5;
  background: #f7f8ef;
  padding: 0 26rpx;
}
.history-row {
  padding: 22rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid #e8ecdf;
}
.history-row:last-child {
  border-bottom: 0;
}
.history-title {
  font-size: 25rpx;
  margin-bottom: 8rpx;
  color: #425b48;
}
.empty-panel {
  border: 1rpx dashed #d8dfcb;
  border-radius: 28rpx;
  padding: 40rpx 28rpx;
  background: #fffdf5;
  text-align: center;
}
.empty-symbol {
  width: 76rpx;
  height: 76rpx;
  line-height: 72rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: #eaf0da;
  color: #8b9e5f;
  font-size: 48rpx;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
}
.body-copy {
  color: #7a8373;
  font-size: 25rpx;
  line-height: 1.9;
  margin: 18rpx 0 24rpx;
  word-break: break-all;
}
.primary-action {
  background: #286145;
  color: #fffbed;
  font-size: 26rpx;
  border-radius: 48rpx;
  padding: 7rpx 28rpx;
  margin: 26rpx 16rpx 0;
}
.explore-more {
  background: transparent;
  color: #35674a;
  border: 1rpx solid #b8c6ad;
  border-radius: 48rpx;
  font-size: 26rpx;
  padding: 7rpx 22rpx;
  margin: 30rpx 0;
}
.local-note {
  color: #93998c;
  padding: 30rpx 12rpx 0;
  font-size: 22rpx;
  line-height: 1.8;
}
.local-note-title {
  color: #73836b;
  margin-bottom: 8rpx;
  font-size: 24rpx;
}
.local-note-extra {
  margin-top: 12rpx;
}
