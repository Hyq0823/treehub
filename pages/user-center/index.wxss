page { color: #23426f; background: #f2f7ff; }
.archive-page { min-height: 100vh; padding: 36rpx 30rpx calc(50rpx + env(safe-area-inset-bottom)); background: radial-gradient(ellipse at 90% 0, #dfedff, transparent 40%), linear-gradient(180deg, #f2f7ff, #fbfcff 60%, #f1f6ff); }
.page-heading { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; }.eyebrow { color: #81a0ce; font-size: 17rpx; letter-spacing: 4rpx; }.page-title { margin-top: 10rpx; color: #25477c; font-size: 49rpx; font-weight: 700; }.privacy-button { color: #7a9dce; border: 1rpx solid #dce8fa; background: #ffffffb3; border-radius: 25rpx; padding: 12rpx 20rpx; font-size: 20rpx; }.page-subtitle { margin: 17rpx 0 28rpx; color: #91a3bc; font-size: 23rpx; line-height: 1.7; }
.stats-panel { display: flex; padding: 30rpx 12rpx; border: 1rpx solid #e3ecfa; border-radius: 27rpx; background: #fff; box-shadow: 0 12rpx 30rpx #648fc308; }.stat { flex: 1; text-align: center; border-right: 1rpx solid #e8eff9; }.stat:last-child { border: 0; }.stat-number { color: #477fe1; font-size: 42rpx; font-weight: 650; }.stat-number text { color: #a6b7cf; font-size: 23rpx; font-weight: 400; }.stat-label { color: #94a7c0; margin-top: 8rpx; font-size: 20rpx; }
.tree-entry { display: flex; align-items: center; gap: 18rpx; padding: 23rpx; margin-top: 20rpx; border: 1rpx solid #dce7fb; border-radius: 24rpx; background: linear-gradient(115deg, #e9f2ff, #f4f1ff); }.tree-entry-symbol { width: 64rpx; height: 64rpx; line-height: 64rpx; text-align: center; flex: 0 0 64rpx; border-radius: 20rpx; background: #fff9; color: #7c9fdd; font-size: 43rpx; }.tree-entry-copy { flex: 1; min-width: 0; }.tree-entry-title { color: #5477af; font-size: 24rpx; font-weight: 600; }.tree-entry-note { color: #94a7c4; font-size: 19rpx; margin-top: 8rpx; line-height: 1.6; }.tree-entry > text { color: #81a3d5; font-size: 27rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 15rpx; }.records-heading { margin: 36rpx 0 22rpx; }.section-title { font-size: 29rpx; font-weight: 650; color: #2d4e80; }.section-aside { color: #a3b1c5; font-size: 19rpx; }
.record-group { overflow: hidden; margin-bottom: 20rpx; border: 1rpx solid #e4edf9; border-radius: 26rpx; background: #fff; box-shadow: 0 9rpx 24rpx #6287b307; }.group-heading { display: flex; justify-content: space-between; align-items: center; padding: 25rpx 26rpx 0; gap: 18rpx; }.group-name { color: #375682; font-size: 26rpx; font-weight: 650; }.record-count { padding: 4rpx 13rpx; border-radius: 15rpx; color: #88a2c8; background: #f0f5ff; font-size: 19rpx; }
.latest-record { padding: 24rpx 26rpx 20rpx; }.latest-label { color: #a1b1c7; font-size: 19rpx; }.latest-title { display: flex; justify-content: space-between; gap: 20rpx; margin: 10rpx 0; color: #3a69ad; font-size: 30rpx; font-weight: 650; line-height: 1.5; }.record-date { color: #a2b2c9; font-size: 20rpx; line-height: 1.7; }.record-arrow { color: #8aabde; font-size: 28rpx; }.premium-history-badge { display: inline-block; padding: 3rpx 10rpx; margin-left: 8rpx; border-radius: 12rpx; color: #a68c59; background: #fff4d9; font-size: 17rpx; vertical-align: middle; }
.group-actions { display: flex; justify-content: space-between; margin: 0 26rpx; padding: 13rpx 0; border-top: 1rpx solid #edf2fa; }button { margin: 0; }button::after { border: 0; }.text-action { padding: 6rpx 0; color: #6c94ce; background: transparent; font-size: 23rpx; line-height: 1.8; }.muted-action { color: #9aaec9; }.record-history { padding: 0 26rpx; border-top: 1rpx solid #edf2fa; background: #f9fbff; }.history-row { display: flex; justify-content: space-between; align-items: center; gap: 18rpx; padding: 21rpx 0; border-bottom: 1rpx solid #eaf0f9; }.history-row:last-child { border: 0; }.history-title { margin-bottom: 7rpx; color: #6b89b0; font-size: 24rpx; }
.empty-panel { padding: 40rpx 28rpx; border: 1rpx dashed #cfdff3; border-radius: 29rpx; text-align: center; background: #ffffffd9; }.empty-symbol { width: 79rpx; height: 79rpx; line-height: 79rpx; border-radius: 50%; margin: 0 auto 22rpx; color: #92b0e4; background: #edf4ff; font-size: 42rpx; }.empty-title { color: #5279af; font-size: 30rpx; font-weight: 600; }.body-copy { margin: 20rpx 0; color: #94a6bf; font-size: 24rpx; line-height: 1.9; }.footnote { color: #a5b4c8; font-size: 20rpx; margin-top: 20rpx; line-height: 1.8; }.primary-action { color: #fff; background: linear-gradient(100deg, #6ca8fd, #3d7bf1); border-radius: 45rpx; font-size: 25rpx; line-height: 1.8; padding: 15rpx; margin-top: 26rpx; box-shadow: 0 8rpx 22rpx #8db4f544; }.explore-more { margin: 28rpx 0; padding: 12rpx; border: 1rpx solid #d8e5fa; border-radius: 45rpx; background: #fff9; color: #739ad3; font-size: 24rpx; }
.cloud-note { padding: 24rpx; margin-top: 28rpx; border: 1rpx solid #e0eafa; border-radius: 24rpx; background: #eef5ff; font-size: 22rpx; color: #8ca4c7; line-height: 1.7; }.cloud-note-heading { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; }.cloud-note-title { color: #628ac2; font-size: 24rpx; font-weight: 600; }.cloud-note-detail { margin-top: 8rpx; font-size: 21rpx; }.cloud-pending { border-color: #eee0c3; background: #fff9ed; }.cloud-pending .cloud-note-title { color: #a48b5e; }.cloud-retry { flex-shrink: 0; border-radius: 28rpx; background: #709ce6; color: #fff; font-size: 22rpx; line-height: 2; padding: 5rpx 20rpx; }.cloud-management { display: flex; justify-content: space-between; gap: 12rpx; margin-top: 19rpx; padding-top: 18rpx; border-top: 1rpx solid #dce7f8; color: #7d9dcb; font-size: 21rpx; }.archive-footnote { margin-top: 28rpx; color: #a4b3c9; font-size: 19rpx; line-height: 1.8; text-align: center; }
.body-copy, .cloud-note-detail { color: #617b9f; }.tree-entry-note, .record-date { color: #788ea9; }
