<view class="answer-page">
  <!-- 加载状态 -->
  <view wx:if="{{error}}" class="loading-container">
    <text class="loading-text">{{error}}</text>
    <button bindtap="goToHome">返回探索大厅</button>
  </view>
  <view wx:elif="{{!test.id}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 内容区域 -->
  <view wx:else>
    <!-- 顶部进度信息 -->
    <view class="header">
      <view class="progress-section">
        <text class="progress-text">{{currentQuestionIndex + 1}} / {{test.questionsCount}}</text>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{(currentQuestionIndex + 1) / test.questionsCount * 100}}%"></view>
        </view>
      </view>
    </view>

    <!-- 问题卡片 -->
    <view class="question-card">
      <view class="question-number">问题 {{currentQuestionIndex + 1}}</view>
      <view class="question-content">{{question.text}}</view>

      <!-- 选项列表 -->
      <view class="options-list">
        <view wx:for="{{question.options}}" wx:key="letter"
          class="option-item {{selectedOption === index ? 'option-selected' : ''}}"
          bindtap="selectOption"
          data-index="{{index}}">
          <view class="option-content">
            <view class="option-letter">{{item.letter}}</view>
            <view class="option-text">{{item.text}}</view>
          </view>
          <view wx:if="{{selectedOption === index}}" class="option-check">✓</view>
        </view>
      </view>
    </view>

    <!-- 底部导航 -->
    <view class="footer">
      <button class="nav-btn prev-btn" bindtap="prevQuestion" disabled="{{currentQuestionIndex === 0}}">
        上一题
      </button>
      <button class="nav-btn next-btn" bindtap="nextQuestion" disabled="{{submitting || submitted}}" loading="{{submitting}}">
        {{currentQuestionIndex === test.questionsCount - 1 ? '查看报告' : '下一题'}}
      </button>
    </view>
  </view>
</view>
