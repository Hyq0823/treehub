/* 答题页面样式 */
.answer-page {
  min-height: 100vh;
  background-color: var(--warm-gray);
  font-family: 'PingFang SC', sans-serif;
  display: flex;
  flex-direction: column;
  padding: 20px 16px;
}

/* 加载状态 */
.loading-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
}

.loading-spinner {
  width: 40px;
  height: 40px;
  border: 4px solid #E5E7EB;
  border-top: 4px solid var(--sky-blue);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  font-size: 16px;
  color: var(--medium-gray);
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 顶部进度区域 */
.header {
  margin-bottom: 20px;
}

.progress-section {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.progress-text {
  font-size: 14px;
  color: var(--medium-gray);
  text-align: center;
  font-weight: 500;
}

.progress-bar {
  width: 100%;
  height: 8px;
  background-color: #E5E7EB;
  border-radius: 4px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: red;
  border-radius: 4px;
  transition: width 0.3s ease;
}

/* 问题卡片 */
.question-card {
  background-color: var(--white);
  border-radius: 20px;
  padding: 24px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.06);
  flex: 1;
  margin-bottom: 24px;
}

.question-number {
  font-size: 14px;
  color: var(--sky-blue);
  font-weight: 600;
  margin-bottom: 16px;
}

.question-content {
  font-size: 18px;
  font-weight: 600;
  color: var(--dark-gray);
  line-height: 1.5;
  margin-bottom: 32px;
}

/* 选项列表 */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.option-item {
  background-color: var(--white);
  border: 2px solid #BFDBFE;
  border-radius: 12px;
  padding: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.3s ease;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.option-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    to right,
    transparent,
    rgba(59, 130, 246, 0.1),
    transparent
  );
  transition: left 0.5s ease;
}

.option-item:hover::before {
  left: 100%;
}

.option-item:hover {
  border-color: #3a75b0;
  box-shadow: 0 6px 16px rgba(58, 117, 176, 0.15);
  transform: translateY(-2px);
}

.option-item:active {
  transform: translateY(0);
  box-shadow: 0 4px 12px rgba(58, 117, 176, 0.1);
}

.option-selected {
  background-color: #fff2f0;
  border-color: red;
  box-shadow: 0 0 0 3px rgba(255, 0, 0, 0.2);
  animation: optionSelect 0.3s ease;
  position: relative;
}

.option-selected::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border: 2px solid red;
  border-radius: 12px;
  animation: pulse 1s ease-in-out;
}

@keyframes pulse {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.02);
    opacity: 0.8;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes optionSelect {
  0% {
    transform: scale(0.98);
  }
  50% {
    transform: scale(1.02);
  }
  100% {
    transform: scale(1);
  }
}

.question-card {
  background-color: var(--white);
  border-radius: 20px;
  padding: 24px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.06);
  flex: 1;
  margin-bottom: 24px;
  animation: fadeInUp 0.5s ease;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.option-content {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  flex: 1;
}

.option-letter {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background-color: #E5E7EB;
  color: var(--medium-gray);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 600;
  flex-shrink: 0;
}

.option-selected .option-letter {
  background-color: var(--sky-blue);
  color: white;
}

.option-text {
  font-size: 16px;
  color: var(--dark-gray);
  line-height: 1.5;
  flex: 1;
}

.option-check {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background-color: var(--sky-blue);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 600;
  flex-shrink: 0;
}

/* 底部导航 */
.footer {
  display: flex;
  gap: 16px;
}

.nav-btn {
  flex: 1;
  border-radius: 40px;
  font-size: 16px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: all 0.3s ease;
  border: none;
  outline: none;
  padding: 14px 24px;
}

.prev-btn {
  background-color: var(--white);
  color: #3a75b0;
  border: 2px solid #e0e7ff;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.prev-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.next-btn {
  background-color: #3a75b0;
  color: white;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4px 12px rgba(58, 117, 176, 0.3);
}

.next-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    to right,
    transparent,
    rgba(255, 255, 255, 0.2),
    transparent
  );
  transition: left 0.5s ease;
}

.next-btn:hover::before {
  left: 100%;
}

.prev-btn:hover {
  background-color: #f0f4ff;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);
}

.next-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(58, 117, 176, 0.4);
}

.prev-btn:active {
  transform: translateY(0);
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.next-btn:active {
  transform: translateY(0);
  box-shadow: 0 4px 12px rgba(58, 117, 176, 0.3);
}

