page { background: #f2f7ff; color: #244777; }
.answer-page { position: relative; min-height: 100vh; padding: 28rpx 28rpx calc(42rpx + env(safe-area-inset-bottom)); overflow: hidden; background: radial-gradient(circle at 100% 12%, #e0ebff, transparent 40%), radial-gradient(circle at 0 85%, #e6f4ff, transparent 35%), linear-gradient(165deg, #f1f7ff, #fbfcff 60%, #eef4ff); }
.tech-grid { position: absolute; inset: 0; pointer-events: none; opacity: .25; background-image: radial-gradient(circle, #a2c2f3 1.5rpx, transparent 1.5rpx); background-size: 58rpx 58rpx; mask-image: linear-gradient(to bottom, #000, transparent 80%); }
.ambient { position: absolute; pointer-events: none; border-radius: 50%; background: #ffffffa3; }.ambient-one { width: 180rpx; height: 180rpx; top: 6%; right: -130rpx; }.ambient-two { width: 290rpx; height: 290rpx; bottom: 6%; left: -230rpx; }
.answer-shell { position: relative; z-index: 1; }.session-header { margin-bottom: 24rpx; }.session-meta { display: flex; justify-content: space-between; align-items: center; gap: 15rpx; color: #8aa2c5; font-size: 18rpx; }.session-meta > view { display: flex; align-items: center; gap: 9rpx; color: #8ba2c3; }.session-meta > text { max-width: 42%; text-align: right; }.live-dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: #83b4f4; }
.progress-console { margin-top: 23rpx; padding: 24rpx 26rpx; border: 1rpx solid #fff; border-radius: 27rpx; background: #ffffffd9; box-shadow: 0 12rpx 35rpx #759bd00c; }.progress-numbers { display: flex; align-items: center; justify-content: space-between; color: #6d98dc; font-family: Georgia, serif; font-size: 23rpx; }.current-number { color: #4c82dc; font-size: 43rpx; font-weight: 700; }.total-number { color: #a7bad6; font-size: 22rpx; }.progress-track { height: 10rpx; margin: 17rpx 0 14rpx; border-radius: 10rpx; background: #eaf1fd; overflow: hidden; }.progress-fill { position: relative; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #7fb8ff, #4e87f1); transition: width .3s ease; }.progress-scan { position: absolute; top: 0; bottom: 0; right: 0; width: 23rpx; border-radius: 12rpx; background: #b7d8ff; }.progress-caption { display: flex; justify-content: space-between; color: #a2b3cb; font-size: 18rpx; }
.question-card { position: relative; padding: 33rpx 27rpx 30rpx; border: 1rpx solid #dce9fc; border-radius: 31rpx; background: #ffffffed; box-shadow: 0 20rpx 55rpx #698fc510; overflow: hidden; }.question-card::before { content: ''; position: absolute; left: 28rpx; right: 28rpx; top: 0; height: 3rpx; border-radius: 5rpx; background: linear-gradient(90deg, transparent, #accdfb, #d3cffa, transparent); }.motion-0 { animation: questionInA .3s ease; }.motion-1 { animation: questionInB .3s ease; }
.question-topline { display: flex; justify-content: space-between; align-items: center; }.question-number { color: #99b1d6; font-size: 18rpx; letter-spacing: 3rpx; }.signal { display: flex; align-items: flex-end; gap: 6rpx; }.signal text { display: block; width: 5rpx; border-radius: 5rpx; background: #b0cafa; }.signal text:nth-child(1) { height: 9rpx; }.signal text:nth-child(2) { height: 15rpx; }.signal text:nth-child(3) { height: 22rpx; }
.question-content { margin-top: 27rpx; color: #264775; font-size: 35rpx; font-weight: 650; line-height: 1.6; }.question-hint { margin: 18rpx 0 29rpx; color: #99abc5; font-size: 21rpx; }.options-list { display: flex; flex-direction: column; gap: 17rpx; }
.option-item { position: relative; display: flex; align-items: center; min-height: 121rpx; padding: 21rpx; border: 1rpx solid #e0eafa; border-radius: 23rpx; background: linear-gradient(140deg, #ffffff, #f9fbff); overflow: hidden; transition: transform .18s ease, border-color .18s ease, background .18s ease; }.option-glow { position: absolute; inset: 0; opacity: 0; background: linear-gradient(110deg, #e9f2ff, #f0f2ff); transition: opacity .2s ease; }.option-content { position: relative; z-index: 1; display: flex; align-items: center; gap: 18rpx; flex: 1; }.option-letter { flex: 0 0 55rpx; width: 55rpx; height: 55rpx; line-height: 55rpx; text-align: center; border-radius: 17rpx; color: #8da8d2; background: #edf4ff; border: 1rpx solid #e4edfc; font-family: Georgia, serif; font-size: 23rpx; transition: background .2s ease; }.option-text { color: #5e779c; font-size: 27rpx; line-height: 1.6; }.option-state { position: relative; z-index: 1; margin-left: 14rpx; }.state-ring { width: 31rpx; height: 31rpx; padding: 6rpx; border: 2rpx solid #c6d5eb; border-radius: 50%; }.state-core { width: 100%; height: 100%; border-radius: 50%; background: #fff; animation: corePop .23s ease; }
.option-selected { border-color: #84b0f6; background: #edf4ff; transform: translateX(4rpx); box-shadow: 0 6rpx 18rpx #77a6ed22; }.option-selected .option-glow { opacity: 1; }.option-selected .option-letter { color: #fff; border-color: transparent; background: linear-gradient(135deg, #79b1fb, #4b86ef); box-shadow: 0 5rpx 12rpx #8eb8ef44; }.option-selected .option-text { color: #3c6aa9; }.option-selected .state-ring { background: #6b9def; border-color: #6b9def; }.option-pressed { transform: scale(.985); }
.choice-feedback { height: 0; opacity: 0; overflow: hidden; color: #7f9ecb; font-size: 20rpx; text-align: center; transition: height .2s ease, opacity .2s ease; }.choice-feedback-visible { height: 43rpx; padding-top: 16rpx; opacity: 1; }.choice-feedback text { display: inline-block; margin-right: 8rpx; color: #729fdf; }
.footer-console { display: flex; gap: 16rpx; margin-top: 25rpx; }.nav-btn { margin: 0; border-radius: 50rpx; padding: 23rpx 20rpx; font-size: 25rpx; font-weight: 600; line-height: 1.5; }.nav-btn::after { border: 0; }.prev-btn { flex: 0 0 186rpx; color: #94aac8; background: #ffffffb3; border: 1rpx solid #dfe9f8; }.next-btn { flex: 1; color: #fff; background: linear-gradient(100deg, #70afff, #3e7bf2); box-shadow: 0 10rpx 25rpx #8eb3f43d; }.nav-btn[disabled] { opacity: .4; }.privacy-line { margin-top: 22rpx; color: #a0b2ce; font-size: 18rpx; line-height: 1.8; text-align: center; }.privacy-line text { color: #8fb2e8; font-size: 12rpx; margin-right: 7rpx; }
.loading-container { position: relative; z-index: 1; min-height: 75vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx; text-align: center; }.glass-panel { padding: 40rpx; border: 1rpx solid #dbe8fb; border-radius: 30rpx; background: #ffffffd9; }.loading-orbit { width: 100rpx; height: 100rpx; padding: 22rpx; border: 2rpx solid #d7e7ff; border-top-color: #7da9ef; border-radius: 50%; animation: spin 1.5s linear infinite; }.loading-core { width: 100%; height: 100%; border-radius: 50%; background: linear-gradient(135deg, #c1ddff, #90b5f3); }.loading-text { color: #94a9c7; font-size: 24rpx; line-height: 1.7; }.error-core { width: 76rpx; height: 76rpx; line-height: 76rpx; border-radius: 50%; background: #fff3d9; color: #b69b68; font-size: 38rpx; }.return-button { color: #fff; background: #729fee; border-radius: 40rpx; font-size: 24rpx; }.return-button::after { border: 0; }
@keyframes questionInA { from { opacity: 0; transform: translateX(18rpx); } to { opacity: 1; transform: none; } }
@keyframes questionInB { from { opacity: 0; transform: translateX(-18rpx); } to { opacity: 1; transform: none; } }
@keyframes corePop { from { transform: scale(0); } 70% { transform: scale(1.16); } to { transform: scale(1); } }
@keyframes spin { to { transform: rotate(360deg); } }
.question-hint { color: #7a91b0; }.option-text { color: #526e96; }
