<view class="detail-page">
  <view class="tech-grid"></view><view class="detail-orb orb-one"></view><view class="detail-orb orb-two"></view>
  <view wx:if="{{error}}" class="detail-error"><view>这份探索暂时未能打开</view><text>{{error}}</text><button bindtap="goToHome">返回探索页</button></view>
  <view wx:else class="detail-shell">
    <view class="protocol-line"><text class="protocol-dot"></text> PERSONALITY TREE <text>给自己一点时间</text></view>
    <view class="hero-panel">
      <view class="hero-scan"></view>
      <view class="icon-orbit"><view class="orbit-ring ring-one"></view><view class="orbit-ring ring-two"></view><image wx:if="{{test.cover}}" class="test-cover" src="{{test.cover}}" mode="aspectFit"/><view wx:else class="test-icon">{{test.icon}}</view><view class="orbit-node node-one"></view><view class="orbit-node node-two"></view></view>
      <view class="test-label">一份认识自己的小小开始</view>
      <view class="test-name">{{test.displayName || test.name}}</view>
      <view class="test-description">{{test.description}}</view>
      <view wx:if="{{test.dimensionLabels.length}}" class="dimension-chips"><text wx:for="{{test.dimensionLabels}}" wx:key="*this">{{item}}</text></view>
      <view wx:if="{{test.note}}" class="quiz-note">{{test.note}}</view>
      <view class="meta-grid"><view><text>{{test.formatValue}}</text><text>{{test.formatLabel}}</text></view><view><text>{{test.time}}</text><text>预计耗时</text></view><view><text>∞</text><text>可反复探索</text></view></view>
    </view>
    <view wx:if="{{draft}}" class="draft-panel">
      <view class="draft-heading"><text class="draft-symbol">↗</text><view><view>上次的探索，还为你留着</view><text>{{draft.contextLabel}} · 进度仅保存在本机</text></view></view>
      <view class="draft-progress-copy">{{draft.allAnswered ? '已全部答完，检查后可生成报告' : draft.ranking ? '已排好 ' + draft.selectedCount + ' 个选择，继续你的第一反应' : '已记录 ' + draft.answeredCount + ' / ' + draft.totalCount + ' 题，不用从头再来'}}</view>
      <view wx:if="{{!draft.ranking}}" class="draft-progress-track"><view style="width:{{draft.progressPercent}}%"></view></view>
      <button class="draft-resume" bindtap="resumeTest" disabled="{{starting}}">{{draft.allAnswered ? '检查答案并生成报告' : '继续上次探索'}} <text>→</text></button>
    </view>
    <view wx:if="{{draftMessage}}" class="draft-message">{{draftMessage}}</view>
    <view class="context-panel">
      <view class="context-heading"><view>{{draft ? '重新开始时，想记录哪种状态？' : hasHistory ? '这次回来，是因为什么？' : '这次为什么想看看自己？'}}</view><text>只保存在本机</text></view>
      <view class="context-options"><view wx:for="{{contextOptions}}" wx:key="id" class="context-option {{selectedContext === item.id ? 'context-selected' : ''}}" data-id="{{item.id}}" bindtap="selectContext" role="button"><text>{{item.icon}}</text><view>{{item.label}}</view></view></view>
    </view>
    <view class="guide-panel">
      <view class="guide-title"><text>把这段时间，留给自己</text><text>温柔的小提示</text></view>
      <view class="guide-item"><text>01</text><view><view>找到相对安静的环境</view><view>给直觉一点完整空间</view></view></view>
      <view class="guide-item"><text>02</text><view><view>依据最近真实状态回答</view><view>不需要选择“更好”的答案</view></view></view>
      <view class="guide-item"><text>03</text><view><view>完成后生成专属画像</view><view>报告与当时的树形，会一起留下</view></view></view>
    </view>
    <view class="start-button {{draft ? 'start-button-restart' : ''}}" bindtap="startTest" hover-class="start-button-pressed" role="button" aria-disabled="{{starting}}"><view class="start-signal">✦</view><view><text>{{draft ? '放下上次，重新开始' : hasHistory ? '开始这次复测' : '开始本次探索'}}</text><text>{{draft ? '清除上次未完成的作答进度' : hasHistory ? '看看这段时间留下了什么' : '给人格树添一片新叶'}}</text></view><text class="start-arrow">→</text></view>
    <view class="safety-line"><text></text> 原始选项仅存本机 · 测评不作心理诊断</view>
  </view>
</view>
