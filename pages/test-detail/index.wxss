page { background: #f2f7ff; color: #274777; }
.detail-page { position: relative; min-height: 100vh; padding: 31rpx 30rpx calc(45rpx + env(safe-area-inset-bottom)); overflow: hidden; background: radial-gradient(circle at 50% 5%, #e1efff, transparent 36%), linear-gradient(165deg, #f1f7ff, #fcfcff 60%, #eef4ff); }.detail-shell { position: relative; z-index: 1; }.tech-grid { position: absolute; inset: 0; pointer-events: none; opacity: .17; background-image: radial-gradient(circle, #a0bff1 1.5rpx, transparent 1.5rpx); background-size: 61rpx 61rpx; }.detail-orb { position: absolute; border-radius: 50%; background: #fff9; pointer-events: none; }.orb-one { width: 220rpx; height: 220rpx; right: -160rpx; top: 22%; }.orb-two { width: 270rpx; height: 270rpx; left: -200rpx; bottom: 12%; }
.protocol-line { display: flex; align-items: center; gap: 10rpx; color: #8fa8ce; font-size: 17rpx; letter-spacing: 2rpx; }.protocol-line > text:last-child { margin-left: auto; color: #a2b3cd; letter-spacing: 0; }.protocol-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: #a8c8f8; }
.hero-panel { position: relative; margin-top: 24rpx; padding: 35rpx 27rpx 27rpx; border: 1rpx solid #fff; border-radius: 33rpx; background: radial-gradient(circle at 50% 0, #e4efff, transparent 60%), #ffffffd9; box-shadow: 0 18rpx 50rpx #6b94c810, inset 0 1rpx #fff; text-align: center; overflow: hidden; animation: panelRise .4s ease; }.hero-scan { display: none; }
.icon-orbit { position: relative; width: 204rpx; height: 204rpx; margin: 0 auto 23rpx; display: flex; align-items: center; justify-content: center; }.orbit-ring { position: absolute; border: 1rpx solid #ccdef9; border-radius: 50%; }.ring-one { inset: 9rpx; transform: rotate(-22deg) scaleY(.8); }.ring-two { inset: 24rpx; border-color: #d7dff8; transform: rotate(35deg) scaleY(.8); }.test-icon { position: relative; width: 121rpx; height: 121rpx; line-height: 121rpx; border-radius: 32rpx; background: linear-gradient(145deg, #f3f8ff, #dcecff 55%, #eae7fc); font-size: 60rpx; box-shadow: inset 0 3rpx 3rpx #fff, 0 16rpx 30rpx #a5c2eb33; }.orbit-node { position: absolute; width: 12rpx; height: 12rpx; border-radius: 50%; background: #b5d3ff; box-shadow: 0 2rpx 7rpx #fff; }.node-one { top: 30rpx; left: 50%; }.node-two { right: 15rpx; bottom: 52rpx; background: #e4cf9f; }
.test-label { color: #a1b3ce; font-size: 18rpx; letter-spacing: 2rpx; }.test-name { margin-top: 15rpx; color: #2a4b7e; font-size: 41rpx; font-weight: 700; line-height: 1.4; }.test-description { max-width: 590rpx; margin: 19rpx auto 27rpx; color: #92a6c2; font-size: 24rpx; line-height: 1.8; }
.meta-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }.meta-grid > view { padding: 18rpx 7rpx; border: 1rpx solid #e4edfb; border-radius: 18rpx; background: #f7faff; }.meta-grid text { display: block; }.meta-grid text:first-child { color: #719cdb; font-family: Georgia, serif; font-size: 25rpx; font-weight: 600; }.meta-grid text:last-child { margin-top: 6rpx; color: #a7b7cd; font-size: 17rpx; }
.guide-panel { margin-top: 21rpx; padding: 27rpx; border: 1rpx solid #e2ebf9; border-radius: 28rpx; background: #ffffffd9; }.guide-title { display: flex; justify-content: space-between; gap: 15rpx; color: #5476a6; font-size: 25rpx; font-weight: 600; }.guide-title text:last-child { color: #b0bdd0; font-size: 17rpx; font-weight: 400; }.guide-item { display: flex; align-items: center; gap: 18rpx; padding-top: 22rpx; }.guide-item > text { flex: 0 0 47rpx; color: #a5badb; font-family: Georgia, serif; font-size: 21rpx; }.guide-item > view > view:first-child { color: #7590b4; font-size: 23rpx; }.guide-item > view > view:last-child { margin-top: 6rpx; color: #b0bdd1; font-size: 19rpx; }
.start-button { display: flex; align-items: center; gap: 18rpx; margin-top: 25rpx; padding: 24rpx; border: 1rpx solid #8fbbff; border-radius: 51rpx; color: #fff; background: linear-gradient(105deg, #75b0fc, #3f7df2); box-shadow: 0 12rpx 28rpx #8eb6f440, inset 0 2rpx #ffffff44; transition: transform .18s ease; }.start-signal { flex: 0 0 58rpx; width: 58rpx; height: 58rpx; line-height: 58rpx; border-radius: 50%; text-align: center; background: #ffffff24; color: #fff4cb; }.start-button > view:nth-child(2) { flex: 1; }.start-button text { display: block; }.start-button view text:first-child { font-size: 27rpx; font-weight: 650; }.start-button view text:last-child { margin-top: 3rpx; font-size: 17rpx; color: #d8e8ff; }.start-arrow { font-size: 34rpx; }.start-button-pressed { transform: scale(.985); }.safety-line { margin-top: 21rpx; color: #a4b4cc; font-size: 18rpx; text-align: center; line-height: 1.8; }.safety-line text { display: inline-block; width: 7rpx; height: 7rpx; border-radius: 50%; background: #a8c8ef; margin-right: 8rpx; }
.detail-error { position: relative; margin-top: 70rpx; padding: 38rpx 26rpx; border: 1rpx solid #e2eafa; border-radius: 29rpx; background: #fff; text-align: center; color: #6f8cba; font-size: 29rpx; }.detail-error text { display: block; margin: 23rpx 0; color: #9aabc5; font-size: 24rpx; line-height: 1.8; }.detail-error button { color: #fff; background: #729fee; border-radius: 40rpx; font-size: 25rpx; }.detail-error button::after { border: 0; }
@keyframes panelRise { from { opacity: 0; transform: translateY(16rpx); } to { opacity: 1; transform: none; } }
.test-description { color: #667f9f; }.guide-item > view > view:first-child { color: #637fa3; }.guide-item > view > view:last-child { color: #8296b0; }
