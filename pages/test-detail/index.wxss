page { background: #06121c; color: #effffb; }
.detail-page { position: relative; min-height: 100vh; padding: 34rpx 30rpx calc(48rpx + env(safe-area-inset-bottom)); overflow: hidden; background: radial-gradient(circle at 50% 12%, rgba(65, 218, 188, .14), transparent 32%), linear-gradient(165deg, #071721, #06111b 60%, #0a1724); }
.tech-grid { position: fixed; inset: 0; pointer-events: none; opacity: .2; background-image: linear-gradient(rgba(99,235,210,.08) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(99,235,210,.08) 1rpx, transparent 1rpx); background-size: 52rpx 52rpx; }
.detail-orb { position: fixed; border-radius: 50%; filter: blur(28rpx); animation: orbMove 8s ease-in-out infinite alternate; }
.orb-one { width: 300rpx; height: 300rpx; right: -190rpx; top: 20%; background: rgba(112,91,227,.14); }.orb-two { width: 280rpx; height: 280rpx; left: -170rpx; bottom: 8%; background: rgba(70,223,187,.1); animation-delay: -4s; }
.detail-shell { position: relative; z-index: 1; }
.protocol-line { display: flex; align-items: center; gap: 10rpx; color: #69d9c2; font-size: 18rpx; letter-spacing: 3rpx; }.protocol-line > text:last-child { margin-left: auto; color: #d5c86b; }.protocol-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #67f1d0; box-shadow: 0 0 18rpx #67f1d0; animation: protocolPulse 1.5s infinite; }
.hero-panel { position: relative; margin-top: 24rpx; padding: 42rpx 30rpx 30rpx; border: 1rpx solid rgba(102,234,209,.2); border-radius: 34rpx; background: linear-gradient(145deg, rgba(15,40,51,.94), rgba(8,26,37,.92)); box-shadow: 0 28rpx 70rpx rgba(0,0,0,.3), inset 0 1rpx rgba(255,255,255,.07); text-align: center; overflow: hidden; animation: panelRise .55s ease; }
.hero-scan { position: absolute; left: -30%; top: 0; width: 30%; height: 100%; background: linear-gradient(90deg, transparent, rgba(100,242,214,.07), transparent); transform: skewX(-12deg); animation: heroScan 4.5s ease-in-out infinite; }
.icon-orbit { position: relative; width: 230rpx; height: 230rpx; margin: 0 auto 24rpx; display: flex; align-items: center; justify-content: center; }
.orbit-ring { position: absolute; border-radius: 50%; border: 1rpx solid rgba(97,228,203,.26); }.ring-one { inset: 18rpx; animation: orbitSpin 9s linear infinite; }.ring-two { inset: 40rpx; border-style: dashed; animation: orbitSpin 6s linear infinite reverse; }
.test-icon { position: relative; width: 118rpx; height: 118rpx; line-height: 118rpx; border-radius: 32rpx; background: linear-gradient(145deg, rgba(95,230,203,.2), rgba(102,84,218,.14)); color: #dfffb7; font-size: 65rpx; box-shadow: inset 0 0 28rpx rgba(108,241,212,.12), 0 0 42rpx rgba(69,220,190,.13); }
.orbit-node { position: absolute; width: 15rpx; height: 15rpx; border-radius: 50%; background: #79f1d2; box-shadow: 0 0 18rpx #6df0cf; }.node-one { top: 21rpx; left: 52%; }.node-two { right: 24rpx; bottom: 48rpx; background: #d8c76c; box-shadow: 0 0 18rpx #d8c76c; }
.test-label { color: #65cfbb; font-size: 18rpx; letter-spacing: 4rpx; }.test-name { margin-top: 13rpx; color: #f1fffb; font-size: 46rpx; font-weight: 700; }.test-description { max-width: 570rpx; margin: 18rpx auto 28rpx; color: #adc2bf; font-size: 25rpx; line-height: 1.8; }
.meta-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; }.meta-grid > view { padding: 18rpx 7rpx; border: 1rpx solid rgba(107,183,177,.15); border-radius: 18rpx; background: rgba(10,31,41,.62); }.meta-grid text { display: block; }.meta-grid text:first-child { color: #78ebcf; font-family: Georgia, serif; font-size: 27rpx; font-weight: 700; }.meta-grid text:last-child { margin-top: 5rpx; color: #69868a; font-size: 17rpx; }
.guide-panel { margin-top: 22rpx; padding: 26rpx; border: 1rpx solid rgba(105,173,172,.16); border-radius: 28rpx; background: rgba(11,31,42,.76); }
.guide-title { display: flex; justify-content: space-between; color: #e7f7f2; font-size: 27rpx; font-weight: 650; }.guide-title text:last-child { color: #627f84; font-size: 17rpx; letter-spacing: 2rpx; }
.guide-item { display: flex; align-items: center; gap: 18rpx; padding-top: 22rpx; }.guide-item > text { flex: 0 0 50rpx; color: #d3bf68; font-family: Georgia, serif; font-size: 21rpx; }.guide-item > view > view:first-child { color: #bdd1ce; font-size: 23rpx; }.guide-item > view > view:last-child { margin-top: 5rpx; color: #627d82; font-size: 19rpx; }
.start-button { display: flex; align-items: center; gap: 18rpx; margin-top: 24rpx; padding: 23rpx; border-radius: 50rpx; color: #08201f; background: linear-gradient(100deg, #61e4c5, #a2efc6 60%, #d8c468); box-shadow: 0 16rpx 38rpx rgba(55,211,181,.22); transition: transform .18s ease; }
.start-signal { flex: 0 0 60rpx; width: 60rpx; height: 60rpx; line-height: 60rpx; border-radius: 50%; text-align: center; background: rgba(6,31,29,.12); animation: signalGlow 1.8s ease-in-out infinite; }.start-button > view:nth-child(2) { flex: 1; }.start-button text { display: block; }.start-button view text:first-child { font-size: 27rpx; font-weight: 750; }.start-button view text:last-child { margin-top: 2rpx; font-size: 15rpx; letter-spacing: 2rpx; opacity: .55; }.start-arrow { font-size: 36rpx; }.start-button-pressed { transform: scale(.985); }
.safety-line { margin-top: 20rpx; color: #58767c; font-size: 18rpx; text-align: center; }.safety-line text { display: inline-block; width: 8rpx; height: 8rpx; border-radius: 50%; background: #5eddbf; margin-right: 8rpx; }
@keyframes orbMove { from { transform: translateY(-24rpx) scale(.9); } to { transform: translate(20rpx, 28rpx) scale(1.1); } }
@keyframes protocolPulse { 0%,100% { opacity: .4; transform: scale(.8); } 50% { opacity: 1; transform: scale(1.2); } }
@keyframes panelRise { from { opacity: 0; transform: translateY(30rpx); } to { opacity: 1; transform: none; } }
@keyframes heroScan { 0%,15% { left: -35%; } 70%,100% { left: 120%; } }
@keyframes orbitSpin { to { transform: rotate(360deg); } }
@keyframes signalGlow { 0%,100% { box-shadow: 0 0 0 rgba(5,31,29,0); } 50% { box-shadow: 0 0 0 12rpx rgba(5,31,29,.06); } }
