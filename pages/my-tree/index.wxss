page { background:#e3f3ff; color:#18365e; }
.tree-page { position:relative; min-height:100vh; overflow:hidden; padding:24rpx 30rpx calc(160rpx + env(safe-area-inset-bottom)); background:linear-gradient(180deg,#d4ebff 0,#e9f5ff 700rpx,#f5f9ff 1280rpx); }
/* 750rpx = 30 + 690 + 30. The scene bleeds to the edges; controls share 30rpx gutters. */
.collection-heading { position:relative; z-index:3; display:flex; justify-content:space-between; align-items:center; color:#476b95; font-size:25rpx; }
.collection-button { flex:none; width:auto; min-height:92rpx; padding:0 0 0 20rpx; margin:0; color:#416b9d; font-size:24rpx; line-height:92rpx; background:transparent; }.collection-button text { margin-left:8rpx; font-size:31rpx; }
.world-heading { position:relative; z-index:3; margin:10rpx 0 0; text-align:center; }.theme-title { font-size:51rpx; font-weight:750; letter-spacing:0; line-height:1.35; color:#153c78; }.theme-caption { margin-top:10rpx; font-size:23rpx; line-height:1.6; color:#466b98; }
.sky-cloud { position:absolute; pointer-events:none; background:#ffffff85; height:56rpx; width:150rpx; border-radius:80rpx; }.sky-cloud::before,.sky-cloud::after { content:''; position:absolute; border-radius:50%; background:inherit; }.sky-cloud::before { width:80rpx; height:80rpx; left:20rpx; bottom:10rpx; }.sky-cloud::after { width:60rpx; height:60rpx; right:12rpx; bottom:9rpx; }.cloud-left { top:350rpx; left:-88rpx; transform:scale(1.5); }.cloud-right { top:170rpx; right:-88rpx; transform:scale(1.8); opacity:.75; }
.hero-scene { position:relative; height:620rpx; margin:0 -30rpx; }.scene-light { position:absolute; width:620rpx; height:620rpx; left:50%; top:0; margin-left:-310rpx; border-radius:50%; background:radial-gradient(ellipse,#ffffffaa,transparent 69%); }.hero-image { position:absolute; width:100%; height:100%; left:0; top:0; animation:sceneBreathe 8s ease-in-out infinite; }
.scene-cloud-bank { position:absolute; bottom:-10rpx; left:-5%; width:110%; height:40rpx; border-radius:50%; background:linear-gradient(0deg,#f4faffb3,transparent); pointer-events:none; }
.scene-progress { position:absolute; z-index:3; right:36rpx; top:24rpx; display:flex; align-items:center; justify-content:center; flex-direction:column; width:110rpx; height:110rpx; border:2rpx solid #ffffffdd; border-radius:50%; background:#fffffff2; box-shadow:0 7rpx 20rpx #5185b80e; }.scene-progress > view { color:#225faa; font-size:34rpx; font-variant-numeric:tabular-nums; }.scene-progress > view text:first-child { font-weight:700; }.scene-progress > view text:last-child { font-size:23rpx; }.scene-progress > text { margin-top:4rpx; color:#516d91; font-size:23rpx; }
.world-quote { position:relative; z-index:2; margin:-2rpx 0 24rpx; text-align:center; color:#365e8c; font-size:25rpx; line-height:1.7; }
.scene-placeholder { position:absolute; inset:20rpx 30rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; border:1rpx dashed #a9c9ef; border-radius:35rpx; background:#f7fbffb3; }.placeholder-leaf { width:100rpx; height:140rpx; margin-bottom:28rpx; border:2rpx solid #9cbfe9; border-radius:85% 15% 85% 15%; transform:rotate(-24deg); background:#e7f3ff; }.placeholder-copy { color:#4e719e; font-size:25rpx; text-align:center; }.scene-placeholder button { margin-top:20rpx; min-height:92rpx; padding:0 25rpx; font-size:24rpx; color:#2168cf; background:transparent; }
.mystery-cover { position:absolute; inset:20rpx 30rpx; display:flex; justify-content:center; align-items:center; flex-direction:column; gap:20rpx; color:#ffffff; background:linear-gradient(160deg,#6b8fc8,#334c83); border-radius:35rpx; }.mystery-star { width:78rpx; height:78rpx; margin-bottom:15rpx; transform:rotate(45deg); border-radius:10rpx; background:#fff0b9; box-shadow:0 0 28rpx #fff0b988; }.mystery-cover > text { font-size:25rpx; }.mystery-cover > text:last-child { color:#e8f2ff; font-size:23rpx; }
.collection-panel { position:relative; z-index:3; margin:0 -8rpx; padding:0 18rpx 22rpx; border-radius:32rpx; background:#ffffffed; border:2rpx solid #ffffff; box-shadow:0 15rpx 45rpx #427ab10c; }
.section-tabs { display:flex; align-items:center; justify-content:space-between; gap:8rpx; margin:0 0 8rpx; }.section-tabs > view { position:relative; flex:1; min-height:92rpx; display:flex; align-items:center; justify-content:center; color:#546c91; font-size:26rpx; white-space:nowrap; }.section-tabs .tab-active { color:#185fd2; font-weight:650; }.tab-active::after { content:''; position:absolute; bottom:10rpx; left:calc(50% - 20rpx); height:6rpx; width:40rpx; border-radius:4rpx; background:#2878ff; }
.theme-scroll { width:100%; white-space:nowrap; }.theme-row { display:inline-flex; gap:14rpx; padding:8rpx 0 9rpx; align-items:stretch; }.theme-tile { position:relative; box-sizing:border-box; flex:0 0 185rpx; width:185rpx; min-width:0; padding:9rpx 8rpx 14rpx; border:2rpx solid #e1ecfc; border-radius:22rpx; background:#f5f9ff; text-align:center; transition:transform 140ms ease,border-color 160ms ease; }.theme-current { border:3rpx solid #2a79ff; background:#edf6ff; }.tile-art { display:block; width:100%; height:145rpx; }.tile-missing { height:145rpx; display:flex; align-items:center; justify-content:center; color:#5779a7; font-size:32rpx; }.tile-name { margin-top:8rpx; color:#254a80; font-size:23rpx; font-weight:650; white-space:nowrap; line-height:1.55; }.tile-status { margin-top:5rpx; color:#45658f; font-size:23rpx; line-height:1.5; }.tile-selected { position:absolute; right:8rpx; top:8rpx; width:30rpx; height:30rpx; border-radius:50%; background:#2978ff; }.tile-selected::after { content:''; position:absolute; left:9rpx; top:5rpx; width:8rpx; height:13rpx; border-right:3rpx solid #fff; border-bottom:3rpx solid #fff; transform:rotate(45deg); }.theme-undiscovered { background:#e5edfb; }.tile-pressed { transform:scale(.98); }
.theme-action { min-height:94rpx; margin:20rpx 0 0; padding:22rpx 16rpx; border-radius:50rpx; font-size:28rpx; line-height:1.55; font-weight:650; color:#ffffff; background:linear-gradient(110deg,#409bff,#1764fb); box-shadow:inset 0 2rpx 0 #ffffff50,0 8rpx 18rpx #407fef29; }.theme-action[disabled] { color:#ffffff; opacity:.75; }.next-reward { padding:16rpx 8rpx 0; text-align:center; color:#526c90; font-size:23rpx; line-height:1.65; }.ad-error { padding:14rpx; color:#9b5538; text-align:center; font-size:24rpx; }
.companion-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16rpx; padding:7rpx 0; }.companion-card { position:relative; display:flex; align-items:center; flex-direction:column; padding:24rpx 13rpx 20rpx; border-radius:24rpx; background:#f1f7ff; border:1rpx solid #e2edfc; text-align:center; }.companion-portrait { position:relative; width:210rpx; height:210rpx; overflow:hidden; }.companion-portrait > text { color:#6e90bd; font-size:85rpx; line-height:210rpx; }.companion-sprite { position:absolute; width:300%; height:600%; max-width:none; }.companion-name { margin-top:13rpx; font-size:26rpx; font-weight:650; color:#214c87; }.companion-line { margin-top:12rpx; color:#4b6b95; font-size:24rpx; line-height:1.75; }.companion-mark { margin-top:18rpx; color:#235faf; background:#dfecff; padding:6rpx 19rpx; border-radius:22rpx; font-size:23rpx; }
.history-list { padding:8rpx 3rpx; }.history-card { display:flex; align-items:center; gap:20rpx; padding:20rpx 4rpx; border-bottom:1rpx solid #e7effa; color:#365f91; font-size:26rpx; }.history-dot { flex:none; width:14rpx; height:14rpx; border:5rpx solid #e3efff; border-radius:50%; background:#659eef; }.history-card text { display:block; margin-top:7rpx; color:#567196; font-size:23rpx; }.history-card .history-leaf { margin-left:auto; font-size:25rpx; color:#a78945; }.history-button { min-height:84rpx; margin-top:18rpx; color:#2368c4; background:transparent; font-size:25rpx; }.history-empty { padding:34rpx 22rpx; text-align:center; color:#274e82; font-size:28rpx; }.history-empty > text { display:block; margin:18rpx 0; font-size:25rpx; line-height:1.7; color:#4e6c95; }.history-empty button { min-height:88rpx; border-radius:44rpx; background:#e3efff; color:#2266c7; font-size:25rpx; }
.pending-card { padding:24rpx; margin-top:20rpx; background:#fff6dd; border:1rpx solid #e6d3a7; border-radius:22rpx; font-size:26rpx; color:#825d26; }.pending-card > text { display:block; margin-top:14rpx; font-size:23rpx; line-height:1.7; }.pending-card button { margin-top:16rpx; min-height:84rpx; font-size:25rpx; color:#78531e; background:#f9e4ad; border-radius:44rpx; }
.share-strip { position:relative; z-index:2; margin-top:24rpx; padding:24rpx 0 12rpx; text-align:center; }.share-strip > view:first-child > view { font-size:30rpx; font-weight:650; color:#285287; }.share-strip > view:first-child > text { display:block; margin-top:10rpx; color:#486a96; font-size:24rpx; }.share-actions { display:flex; gap:16rpx; margin-top:22rpx; }.share-actions button { flex:1; min-height:92rpx; margin:0; display:flex; justify-content:center; align-items:center; padding:17rpx 10rpx; border:1rpx solid #9fc3fa; border-radius:45rpx; background:#f8fcff; color:#2765b6; font-size:25rpx; line-height:1.5; }.share-actions .poster-button { background:#e3efff; border-color:#c6dcfa; font-weight:650; }.privacy-note { margin:20rpx 12rpx 0; color:#526e93; text-align:center; font-size:23rpx; line-height:1.8; }
.theme-moon { background:linear-gradient(180deg,#193260,#294b85 850rpx,#eaf2ff 1340rpx); }.theme-moon .collection-heading,.theme-moon .collection-button,.theme-moon .theme-caption,.theme-moon .world-quote { color:#e6efff; }.theme-moon .theme-title { color:#ffffff; }.theme-moon .sky-cloud { opacity:.12; }.theme-moon .scene-light { background:radial-gradient(ellipse,#8299e733,transparent 70%); }.theme-moon .scene-cloud-bank { opacity:.1; }.theme-moon .collection-panel { box-shadow:0 12rpx 40rpx #12275718; }.theme-romantic { background:linear-gradient(180deg,#e8f2ff,#fffaf0 850rpx,#f8fbff); }
.visitor-banner { position:relative; z-index:3; padding:15rpx 20rpx; margin-bottom:14rpx; border-radius:18rpx; background:#ffffffd9; color:#3b6595; font-size:24rpx; line-height:1.6; }.error-panel { position:relative; margin-top:70rpx; padding:45rpx 30rpx; border-radius:28rpx; background:#ffffff; color:#234c83; text-align:center; font-size:30rpx; }.error-panel > text { display:block; margin:24rpx 0; color:#4c6b94; font-size:25rpx; line-height:1.7; }.error-panel button { min-height:88rpx; color:#2165c9; background:#e4f0ff; font-size:26rpx; border-radius:44rpx; }.page-loading { padding-top:180rpx; text-align:center; color:#426a9b; font-size:28rpx; }
.picker-mask { position:fixed; z-index:120; inset:0; display:flex; align-items:flex-end; background:#13294f66; }.theme-picker { width:100%; max-height:85vh; padding:28rpx 28rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius:38rpx 38rpx 0 0; background:#f8fbff; box-sizing:border-box; }.picker-heading { display:flex; align-items:center; justify-content:space-between; margin-bottom:22rpx; }.picker-heading > view > view { color:#244a80; font-size:32rpx; font-weight:650; }.picker-heading > view > text { display:block; margin-top:10rpx; color:#526d92; font-size:24rpx; }.picker-heading > button { flex:none; width:88rpx; min-height:88rpx; margin:0; display:flex; justify-content:center; align-items:center; color:#42638f; background:transparent; font-size:48rpx; }.picker-scroll { max-height:65vh; }.picker-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16rpx; }.picker-grid .theme-tile { width:auto; min-width:0; padding:14rpx 6rpx; }.picker-grid .tile-name { font-size:22rpx; }.poster-canvas { position:fixed; width:750px; height:1200px; left:-3000px; top:0; pointer-events:none; }button::after { border:0; }
@keyframes sceneBreathe { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-6rpx); } }
.world-paused .hero-image { animation-play-state:paused; }
@media (prefers-reduced-motion:reduce) { .hero-image { animation:none; }.theme-tile { transition:none; } }
