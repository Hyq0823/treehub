page { background: #f2f8ff; color: #193b69; }
.tree-page { position: relative; min-height: 100vh; padding: 30rpx 30rpx calc(56rpx + env(safe-area-inset-bottom)); overflow: hidden; background: radial-gradient(circle at 15% 5%, #d6edff, transparent 28%), linear-gradient(160deg, #eef7ff, #f9fbff 55%, #eaf4ff); }
.page-orb { position: absolute; pointer-events: none; border-radius: 50%; filter: blur(24rpx); opacity: .5; }.orb-a { top: 350rpx; right: -150rpx; width: 350rpx; height: 350rpx; background: #dce2ff; }.orb-b { top: 1300rpx; left: -100rpx; width: 260rpx; height: 260rpx; background: #fff0ce; }
.page-heading { position: relative; display: flex; justify-content: space-between; align-items: center; margin: 8rpx 4rpx 26rpx; }.eyebrow { color: #799ac6; font-size: 17rpx; letter-spacing: 3rpx; }.page-title { margin-top: 7rpx; font-size: 48rpx; font-weight: 750; color: #173e76; }.collection-count { color: #8fa7c7; font-size: 22rpx; }.collection-count text:first-child { color: #3e81df; font-size: 43rpx; font-weight: 650; }
.visitor-banner { position: relative; padding: 21rpx 24rpx; margin-bottom: 20rpx; border-radius: 20rpx; background: #e4efff; color: #5f83b8; font-size: 23rpx; line-height: 1.7; }
.hero-card { position: relative; padding: 28rpx 26rpx 27rpx; overflow: hidden; border-radius: 38rpx; border: 2rpx solid rgba(255,255,255,.92); background: linear-gradient(150deg, #fff, var(--theme-pale) 65%, #e2f0ff); box-shadow: 0 18rpx 50rpx rgba(70,117,180,.1), inset 0 1rpx #fff; }.hero-top { position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: center; gap: 15rpx; }.hero-title { font-size: 35rpx; font-weight: 700; color: #214d87; }.hero-english { margin-top: 5rpx; color: #7fa1c8; font-size: 18rpx; letter-spacing: 2rpx; }.hidden-badge, .recommend-badge { flex-shrink: 0; padding: 9rpx 14rpx; border-radius: 20rpx; color: #987437; background: #fff2cf; font-size: 17rpx; }.recommend-badge { color: #4a89d8; background: #e6f1ff; }
.hero-scene { position: relative; height: 540rpx; margin: 8rpx -26rpx 0; }.hero-image { display: block; width: 100%; height: 100%; }.hero-quote { position: relative; text-align: center; color: #5274a0; font-size: 24rpx; line-height: 1.8; }.tag-list { display: flex; justify-content: center; gap: 13rpx; margin-top: 18rpx; }.tag-list text { padding: 10rpx 20rpx; border: 1rpx solid #d8e7fb; border-radius: 22rpx; color: #6084b4; background: rgba(255,255,255,.75); font-size: 19rpx; }.hero-night { background: radial-gradient(circle at 70% 30%, #435da3, transparent 50%), linear-gradient(150deg, #1e356c, #344c83); }.hero-night .hero-title { color: #f5f7ff; }.hero-night .hero-english, .hero-night .hero-quote { color: #d8e5ff; }.hero-night .tag-list text { background: rgba(231,241,255,.13); color: #e0eaff; border-color: #9fb7ed50; }
.scene-fallback { position: absolute; inset: 0; }.scene-halo { position: absolute; width: 400rpx; height: 400rpx; left: 50%; top: 40rpx; margin-left: -200rpx; border: 1rpx solid #c1d9ff; border-radius: 50%; background: radial-gradient(circle, #fff9, #d7edff55 60%, transparent 70%); animation: glowBreathe 4s ease-in-out infinite; }.scene-halo::after { content: ''; position: absolute; inset: 28rpx; border-radius: 50%; border: 1rpx dashed #91b9e750; }
.fallback-trunk { position: absolute; top: 160rpx; left: 50%; width: 23rpx; height: 270rpx; margin-left: -10rpx; border-radius: 90% 20% 30% 30%; transform: rotate(5deg); background: linear-gradient(90deg, #aec1d4, #fff, #a8bad0); box-shadow: 4rpx 0 8rpx #adcbe566; }.fallback-branch { position: absolute; top: 230rpx; left: 50%; width: 130rpx; height: 12rpx; border-radius: 50%; transform-origin: left; background: #b7cadd; }.branch-a { transform: rotate(-40deg); }.branch-b { top: 290rpx; transform: rotate(-140deg); }
.leaf { position: absolute; left: 50%; width: 90rpx; height: 115rpx; border-radius: 80% 8% 80% 8%; background: linear-gradient(135deg, #ffffffec, var(--theme-color)); border: 2rpx solid #ffffffbd; box-shadow: inset 7rpx 6rpx 15rpx #fff9, 0 6rpx 15rpx #6faae122; }.leaf::after { content: ''; position: absolute; left: 50%; top: 12%; width: 1rpx; height: 80%; background: #fff9; transform: rotate(25deg); }.leaf-a { top: 65rpx; margin-left: -40rpx; transform: rotate(-12deg); }.leaf-b { top: 115rpx; margin-left: 70rpx; transform: rotate(30deg); }.leaf-c { top: 165rpx; margin-left: -150rpx; transform: rotate(-82deg); }.leaf-d { top: 235rpx; margin-left: 60rpx; transform: rotate(28deg); }.leaf-e { top: 275rpx; margin-left: -120rpx; transform: rotate(-80deg); }.leaf-f { top: 190rpx; margin-left: -45rpx; width: 66rpx; height: 82rpx; transform: rotate(5deg); }
.cloud-island { position: absolute; bottom: 48rpx; left: 50%; display: flex; align-items: flex-end; justify-content: space-around; width: 440rpx; height: 140rpx; margin-left: -220rpx; padding: 0 34rpx 12rpx; box-sizing: border-box; border-radius: 50%; background: radial-gradient(ellipse at 50% 80%, #cbdfff, #fff 70%); box-shadow: 0 22rpx 26rpx #77aadd33, inset 0 -12rpx 12rpx #dceaff; }.cloud-island text { position: relative; font-size: 78rpx; transform: translateY(-28rpx); }.cloud-island view { color: var(--theme-accent); font-size: 42rpx; transform: translateY(-20rpx); }.scene-star { position: absolute; color: var(--theme-accent); animation: starFloat 3s ease-in-out infinite alternate; }.star-a { top: 90rpx; left: 22%; font-size: 28rpx; }.star-b { top: 235rpx; right: 15%; font-size: 39rpx; animation-delay: -1s; }.star-c { bottom: 110rpx; left: 18%; font-size: 22rpx; animation-delay: -2s; }
.hero-mystery .hero-image, .hero-mystery .scene-fallback { filter: brightness(.4) saturate(.2) blur(4rpx); }.mystery-cover { position: absolute; inset: 0; display: flex; justify-content: center; align-items: center; flex-direction: column; gap: 18rpx; color: #fff; background: linear-gradient(180deg, #496d9c44, #24476988); }.mystery-cover view { font-size: 75rpx; color: #fff1b5; }.mystery-cover text { font-size: 23rpx; }.mystery-cover text:last-child { font-size: 28rpx; font-weight: 650; }.loading-art { position: absolute; bottom: 5rpx; width: 100%; text-align: center; font-size: 19rpx; color: #789cc6; }
.growth-card { position: relative; margin-top: 23rpx; padding: 25rpx 27rpx; border: 2rpx solid #fff; border-radius: 28rpx; background: #ffffffdb; box-shadow: 0 10rpx 28rpx #6694c90a; }.growth-heading { display: flex; justify-content: space-between; color: #305985; font-size: 25rpx; font-weight: 650; }.growth-heading text:last-child { color: var(--theme-color); font-size: 30rpx; }.leaf-trail { display: flex; align-items: center; justify-content: space-between; position: relative; margin: 25rpx 0 19rpx; }.leaf-trail::before { content: ''; position: absolute; left: 25rpx; right: 25rpx; height: 5rpx; border-radius: 3rpx; background: #e4efff; }.trail-leaf { position: relative; display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; background: #edf3ff; border: 4rpx solid #fff; border-radius: 50%; color: #aac0dd; font-size: 20rpx; }.leaf-collected { color: #fff; background: linear-gradient(145deg, #a2d2ff, var(--theme-color)); box-shadow: 0 4rpx 9rpx #609ddd33; }.next-reward { display: flex; align-items: center; gap: 10rpx; color: #7894b8; font-size: 20rpx; line-height: 1.6; }.next-reward text { color: #dfb665; font-size: 24rpx; }
.section-tabs { position: relative; display: flex; margin: 28rpx 4rpx 22rpx; gap: 26rpx; justify-content: space-between; }.section-tabs > view { position: relative; flex: 1; padding: 14rpx 0; text-align: center; color: #8aa0bf; font-size: 26rpx; }.section-tabs .tab-active { color: #3878d4; font-weight: 700; }.tab-active::after { content: ''; position: absolute; bottom: 0; left: calc(50% - 20rpx); width: 40rpx; height: 6rpx; border-radius: 4rpx; background: #438bff; }
.theme-grid { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 15rpx; }.theme-tile { min-width: 0; padding: 19rpx 8rpx 18rpx; border: 3rpx solid #fff; border-radius: 24rpx; text-align: center; box-shadow: 0 5rpx 12rpx #457cb409; }.theme-current { border-color: #5b9aff; box-shadow: 0 4rpx 18rpx #4d8fed22; }.tile-art { display: block; width: 100%; height: 116rpx; }.tile-companions { display: flex; align-items: center; justify-content: center; height: 116rpx; gap: 4rpx; }.tile-companions text { font-size: 43rpx; }.tile-companions text:last-child { font-size: 33rpx; }.tile-name { color: #4c6a91; font-size: 20rpx; font-weight: 650; white-space: nowrap; }.tile-status { margin-top: 8rpx; color: #8da6c5; font-size: 16rpx; }.theme-current .tile-status { color: #4084e9; }.theme-undiscovered { background: linear-gradient(140deg, #e2ebff, #d9e9f6) !important; }.theme-undiscovered .tile-companions { color: #7496c0; }
.companion-card { position: relative; display: flex; align-items: center; gap: 20rpx; padding: 25rpx 20rpx; margin-bottom: 15rpx; border: 2rpx solid #fff; border-radius: 26rpx; background: #ffffffbb; }.companion-portrait { flex-shrink: 0; width: 100rpx; height: 100rpx; line-height: 100rpx; border-radius: 30rpx; text-align: center; background: var(--theme-pale); font-size: 60rpx; }.companion-name { color: #325b8a; font-size: 25rpx; font-weight: 650; }.companion-line { max-width: 330rpx; margin-top: 8rpx; color: #8c9fb9; font-size: 21rpx; line-height: 1.6; }.companion-mark { margin-left: auto; color: #95b4d6; font-size: 18rpx; }.section-note, .history-tip { padding: 13rpx 12rpx; color: #91a8c3; font-size: 20rpx; line-height: 1.8; text-align: center; }
.history-card { position: relative; display: flex; align-items: center; gap: 18rpx; padding: 22rpx; margin-bottom: 12rpx; border-radius: 22rpx; background: #ffffffbf; font-size: 23rpx; color: #507297; }.history-card text { display: block; margin-top: 6rpx; font-size: 18rpx; color: #93a9c2; }.history-dot { width: 15rpx; height: 15rpx; background: #82b7f7; border: 5rpx solid #e6f1ff; border-radius: 50%; }.history-card .history-leaf { margin-left: auto; font-size: 27rpx; color: #d8bd7c; }.history-button { border: 1rpx solid #d1e3ff; border-radius: 40rpx; color: #6c99d2; font-size: 22rpx; background: #f8fbff; }.history-empty { padding: 35rpx 25rpx; text-align: center; color: #6b8bac; background: #ffffffad; border-radius: 26rpx; }.history-empty > text:first-child { font-size: 70rpx; }.history-empty > view { margin-top: 20rpx; font-size: 28rpx; }.history-empty > text:last-of-type { display: block; margin: 15rpx 0 25rpx; font-size: 20rpx; }.history-empty button { color: #fff; background: #5b9bfa; border-radius: 40rpx; font-size: 24rpx; }
.theme-action { margin: 28rpx 0 0; padding: 25rpx 12rpx; line-height: 1.4; border-radius: 50rpx; background: linear-gradient(105deg, #72b8ff, #287cff 75%, #6b9eff); color: #fff; font-size: 26rpx; font-weight: 650; box-shadow: 0 10rpx 26rpx #3888fa33; }.theme-action[disabled] { opacity: .6; color: #fff; }.unlock-rule { padding: 17rpx 17rpx 8rpx; text-align: center; color: #97abc5; font-size: 18rpx; line-height: 1.7; }.pending-card { position: relative; margin-top: 25rpx; padding: 24rpx; border: 1rpx solid #efdcb0; border-radius: 25rpx; background: #fff9e8; color: #a27c38; font-size: 24rpx; }.pending-card > text { display: block; margin-top: 12rpx; font-size: 21rpx; line-height: 1.7; }.pending-card button { margin-top: 18rpx; color: #92702e; background: #ffe9ae; border-radius: 35rpx; font-size: 22rpx; }.ad-error { color: #bf8b67; font-size: 21rpx; line-height: 1.7; text-align: center; }
.share-card { position: relative; margin-top: 28rpx; padding: 28rpx 25rpx 24rpx; border: 2rpx solid #fff; border-radius: 30rpx; background: #ffffffd9; text-align: center; }.share-card > view:first-child > view { color: #315e98; font-size: 28rpx; font-weight: 650; }.share-card > view:first-child > text { display: block; margin-top: 8rpx; color: #93a7c2; font-size: 20rpx; }.share-actions { display: flex; gap: 15rpx; margin-top: 24rpx; }.share-actions button { flex: 1; margin: 0; padding: 20rpx 8rpx; line-height: 1.4; color: #4e91ec; border: 1rpx solid #a8cbff; border-radius: 40rpx; background: #f8fcff; font-size: 21rpx; }.share-actions button:last-child { background: #e9f3ff; border-color: #d5e7ff; }.privacy-note { position: relative; margin: 25rpx 12rpx 0; color: #a3b4c9; font-size: 18rpx; text-align: center; line-height: 1.8; }
.error-panel { position: relative; padding: 60rpx 30rpx; margin-top: 60rpx; border-radius: 30rpx; background: #fff; text-align: center; color: #6587b0; }.error-panel > view { color: #315d93; font-size: 29rpx; }.error-panel > text { display: block; margin: 22rpx 0; font-size: 23rpx; line-height: 1.7; }.error-panel button { color: #4b8eeb; background: #eaf4ff; border-radius: 40rpx; font-size: 24rpx; }.page-loading { position: relative; padding-top: 200rpx; text-align: center; color: #91a9c8; font-size: 26rpx; }.poster-canvas { position: fixed; width: 750px; height: 1200px; left: -3000px; top: 0; pointer-events: none; }button::after { border: 0; }
@keyframes glowBreathe { 0%,100% { opacity: .7; transform: scale(.97); } 50% { opacity: 1; transform: scale(1.03); } }@keyframes starFloat { from { transform: translateY(0) scale(.8); opacity: .5; } to { transform: translateY(-13rpx) scale(1.1); opacity: 1; } }
.companion-portrait { position: relative; overflow: hidden; }
.companion-sprite { position: absolute; width: 300%; height: 600%; max-width: none; }
