<view class="tree-page {{current.id === 'moon' ? 'theme-moon' : ''}} {{current.id === 'romantic' ? 'theme-romantic' : ''}} {{worldPaused ? 'world-paused' : ''}}" style="--theme-color:{{current.color || '#318aff'}};--theme-pale:{{current.pale || '#e9f5ff'}};--theme-accent:{{current.accent || '#ffd56b'}};">
  <view class="sky-cloud cloud-left"></view><view class="sky-cloud cloud-right"></view>
  <view wx:if="{{error}}" class="error-panel"><view>你的小世界暂时还没打开</view><text>{{error}}</text><button bindtap="loadCollection">重新打开</button></view>
  <block wx:elif="{{loaded && current}}">
    <view class="collection-heading"><text>树与伙伴</text><button class="collection-button" bindtap="openThemePicker">已收藏 {{state.unlocked.length}} / 9 <text>›</text></button></view>
    <view wx:if="{{visitorPreview}}" class="visitor-banner">朋友分享的小世界，也在等你来探索。</view>
    <view wx:if="{{themePreview}}" class="visitor-banner theme-preview-banner">正在预览主题图鉴，当前档案主题没有改变。</view>
    <view class="world-heading"><view class="theme-title" aria-role="heading">{{current.hidden && !current.discovered ? '尚未遇见的极光' : current.name}}</view><view class="theme-caption">{{current.hidden ? '隐藏主题 · 探索中的惊喜' : current.starter && !state.starterClaimed ? '完成首测，即可免费领取' : current.unlocked ? '我的树，和陪伴我的小伙伴' : '完成对应探索后，它会自然长出'}}</view></view>
    <view class="hero-scene {{current.hidden && !current.discovered ? 'hero-mystery' : ''}}">
      <view class="scene-light"></view>
      <image class="hero-image {{heroUrl ? 'async-image-ready' : 'async-image-hidden'}}" src="{{heroUrl}}" mode="aspectFit" binderror="onHeroError" />
      <view class="scene-placeholder {{heroUrl ? 'async-placeholder-hidden' : ''}}"><view class="placeholder-leaf"></view><view class="placeholder-copy">{{current.hidden && !current.discovered ? '极光还藏在下一次探索里' : imageLoading ? '你的小世界正在靠近' : '树与伙伴的画面暂未加载'}}</view><button wx:if="{{!imageLoading && current.discovered}}" bindtap="retryHero">重新加载画面</button></view>
      <view class="scene-progress"><view><text>{{state.uniqueCount}}</text><text> / {{state.catalogCount}}</text></view><text>探索叶片</text></view>
      <view wx:if="{{current.hidden && !current.discovered}}" class="mystery-cover"><view class="mystery-star"></view><text>让五种探索，在树上相遇</text><text>{{state.uniqueCount}} / 5 类不同测试</text></view>
      <view class="scene-cloud-bank"></view>
    </view>
    <view class="world-quote">“{{current.quote}}”</view>
    <view class="collection-panel">
      <view class="section-tabs"><view class="{{tab === 'themes' ? 'tab-active' : ''}}" data-tab="themes" bindtap="selectTab">主题图鉴</view><view class="{{tab === 'companions' ? 'tab-active' : ''}}" data-tab="companions" bindtap="selectTab">我的伙伴</view><view class="{{tab === 'history' ? 'tab-active' : ''}}" data-tab="history" bindtap="selectTab">成长记录</view></view>
      <scroll-view wx:if="{{tab === 'themes'}}" class="theme-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}" enhanced="{{true}}" lower-threshold="80" bindscrolltolower="loadMoreGallery"><view class="theme-row"><view wx:for="{{gallery}}" wx:key="id" class="theme-tile {{item.id === current.id ? 'theme-current' : ''}} {{item.locked ? 'theme-locked' : ''}} {{!item.canPreview ? 'theme-undiscovered' : ''}}" data-id="{{item.id}}" bindtap="inspectTheme" hover-class="tile-pressed"><image class="tile-art {{item.thumbnailUrl ? 'tile-art-ready' : 'tile-art-pending'}}" src="{{item.thumbnailUrl}}" mode="aspectFit" lazy-load="{{true}}" /><view class="tile-missing {{item.thumbnailUrl ? 'tile-missing-hidden' : ''}}"><text>{{item.tileMark}}</text></view><view class="tile-lock {{item.locked ? '' : 'tile-lock-hidden'}}">锁</view><view class="tile-name">{{item.displayName}}</view><view class="tile-status">{{item.statusLabel}}</view><view class="tile-selected {{item.id === current.id ? '' : 'tile-selected-hidden'}}"></view></view></view></scroll-view>
      <view wx:elif="{{tab === 'companions'}}" class="companion-list"><view class="companion-card" wx:for="{{current.companions}}" wx:key="name"><view class="companion-portrait"><image class="companion-sprite {{companionSprite && current.discovered ? 'async-image-ready' : 'async-image-hidden'}}" src="{{companionSprite}}" mode="scaleToFill" style="left:-{{item.spriteColumn * 100}}%;top:-{{item.spriteRow * 100}}%;" binderror="onCompanionError" /><view class="companion-fallback {{companionSprite && current.discovered ? 'async-placeholder-hidden' : ''}}">{{current.discovered ? '◇' : '？'}}</view></view><view class="companion-name">{{current.discovered ? item.name : '尚未相遇的伙伴'}}</view><view class="companion-line">{{current.discovered ? item.line : '让极光带来新的惊喜。'}}</view><text class="companion-mark">{{current.unlocked ? '陪伴中' : '待相遇'}}</text></view></view>
      <view wx:else class="history-list"><view wx:if="{{!history.length}}" class="history-empty"><view>第一枚年轮，等你来留下</view><text>完成首测，拥有自己的树与伙伴。</text><button bindtap="explore">开始第一次探索</button></view><block wx:else><view class="history-card {{item.isRing ? 'history-ring' : ''}}" wx:for="{{history}}" wx:key="id"><view class="history-dot"></view><view><view>{{item.title}}</view><text>{{item.date}}</text></view><text class="history-leaf">{{item.isRing ? '年轮' : '新叶'}}</text></view><button class="history-button" bindtap="openHistory">查看年轮与历史快照 ›</button></block></view>
      <view wx:if="{{pendingSave || saveError}}" class="pending-card"><view>主题等待保存</view><text>{{saveError || '恢复空间后可直接重试。'}}</text><button bindtap="retryThemeSave" loading="{{saving}}" disabled="{{saving}}">重试保存主题</button></view>
      <button class="theme-action" bindtap="handleThemeAction" loading="{{busy || saving}}" disabled="{{busy || saving}}">{{pendingSave ? '保存已获得的主题' : '继续探索，让下一套主题长出'}}</button>
      <view class="next-reward">{{nextReward}}</view>
      <view wx:if="{{adError}}" class="ad-error">{{adError}}</view>
    </view>
    <view class="share-strip"><view><view>你的树，会是什么样？</view><text>把喜欢的小世界，分享给喜欢的人</text></view><view class="share-actions"><button open-type="share">邀请朋友</button><button class="poster-button" bindtap="createPoster" loading="{{posterBusy}}" disabled="{{posterBusy}}">{{current.unlocked ? '生成我的海报' : '解锁后生成海报'}}</button></view></view>
    <view class="privacy-note">主题由测试探索获得。分享不包含答题记录、分数或微信身份。</view>
  </block>
  <view wx:else class="page-loading">正在打开你的主题收藏…</view>
  <view wx:if="{{pickerOpen}}" class="picker-mask" bindtap="closeThemePicker"><view class="theme-picker" catchtap="keepPickerOpen"><view class="picker-heading"><view><view>探索主题图鉴</view><text>主题可以预览，解锁与当前主题仍由档案决定</text></view><button bindtap="closeThemePicker" aria-label="关闭主题图鉴">×</button></view><scroll-view scroll-y="{{true}}" class="picker-scroll"><view class="picker-grid"><view wx:for="{{gallery}}" wx:key="id" class="theme-tile {{item.id === current.id ? 'theme-current' : ''}} {{item.locked ? 'theme-locked' : ''}}" data-id="{{item.id}}" bindtap="inspectTheme"><image class="tile-art {{item.thumbnailUrl ? 'tile-art-ready' : 'tile-art-pending'}}" src="{{item.thumbnailUrl}}" mode="aspectFit" lazy-load="{{true}}" /><view class="tile-missing {{item.thumbnailUrl ? 'tile-missing-hidden' : ''}}"><text>{{item.tileMark}}</text></view><view class="tile-lock {{item.locked ? '' : 'tile-lock-hidden'}}">锁</view><view class="tile-name">{{item.displayName}}</view><view class="tile-status">{{item.statusLabel}}</view></view></view></scroll-view></view></view>
  <canvas type="2d" id="posterCanvas" class="poster-canvas"></canvas>
  <canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>
</view>
