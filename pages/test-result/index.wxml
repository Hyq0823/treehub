<view class="container">
  <view class="result-header">
    <view class="result-title">人格测试树-测试结果</view>
    <view class="result-icon" wx:if="{{test.id !== 'sbti'}}">
      <view class="icon-background">{{getResultIcon(result.title)}}</view>
    </view>
    <view class="result-type">{{result.title}}</view>
    <view class="result-summary">{{result.summary}}</view>
  </view>
  
  <view class="result-image" wx:if="{{result.image}}">
    <image src="{{result.image}}" mode="aspectFit"></image>
  </view>
  
  <view class="result-content">
    <view class="result-description">{{result.description}}</view>
    <view class="result-advice">
      <view class="advice-icon">💡</view>
      <view class="advice-content">{{result.advice}}</view>
    </view>
    <view class="result-note">
      <view class="note-icon">⚠️</view>
      <view class="note-content">小程序不会保存您的报告，请按需截屏保存</view>
    </view>
    <view class="result-note" wx:if="{{result.note}}">
      <view class="note-icon">📝</view>
      <view class="note-content">{{result.note}}</view>
    </view>
  </view>
  
  <view class="result-footer">
    <view class="btn-secondary" bindtap="retakeTest">🔄 再测一次</view>
    <view class="btn-primary" bindtap="goToHome">🏠 返回首页</view>
  </view>
</view>