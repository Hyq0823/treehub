<view class="report-redirect">
  <view class="report-redirect-icon">❧</view>
  <view class="report-redirect-title">{{error ? '报告暂时未能打开' : '正在展开你的报告…'}}</view>
  <block wx:if="{{error}}">
    <view class="report-redirect-error">{{error}}</view>
    <button class="report-redirect-retry" bindtap="openReport">重新打开</button>
    <button class="report-redirect-home" bindtap="goToHome">返回探索大厅</button>
  </block>
</view>
