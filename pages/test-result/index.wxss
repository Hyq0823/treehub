page {
  background: #faf7ef;
  color: #142c35;
}
.result-page {
  padding: 36rpx 32rpx 64rpx;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}
.eyebrow {
  color: #65796d;
  font-size: 24rpx;
  margin: 0 4rpx 24rpx;
  letter-spacing: 2rpx;
}
.result-header,
.content-card,
.state-card {
  background: #fffdf8;
  border: 1rpx solid #ede9dc;
  border-radius: 36rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 10rpx 32rpx rgba(38, 66, 45, 0.04);
}
.result-header {
  text-align: center;
}
.result-icon {
  margin: 0 auto 24rpx;
  width: 136rpx;
  height: 136rpx;
  line-height: 136rpx;
  font-size: 72rpx;
  background: #edf3e5;
  border-radius: 50%;
}
.result-image {
  display: block;
  width: 360rpx;
  height: 360rpx;
  margin: 0 auto 28rpx;
  border-radius: 24rpx;
}
.result-type {
  font-size: 48rpx;
  color: #174a37;
  font-weight: 700;
}
.result-code {
  color: #71846f;
  font-size: 26rpx;
  margin-top: 10rpx;
  letter-spacing: 3rpx;
}
.result-summary {
  font-size: 29rpx;
  line-height: 1.8;
  margin: 24rpx 0;
  color: #4f635b;
}
.saved-badge {
  display: inline-block;
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
  background: #edf4e4;
  color: #47664c;
  font-size: 22rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.body-copy {
  font-size: 28rpx;
  color: #53645c;
  line-height: 1.9;
}
.advice-box {
  background: #f4edd9;
  padding: 28rpx;
  border-radius: 24rpx;
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #756039;
  line-height: 1.85;
}
.advice-label {
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.report-note,
.local-note {
  font-size: 23rpx;
  color: #7b8379;
  line-height: 1.8;
  margin-top: 24rpx;
}
.local-note {
  padding: 0 8rpx;
  margin-bottom: 28rpx;
}
.legacy-note {
  padding: 24rpx;
  background: #fff0d0;
  border-radius: 20rpx;
  font-size: 24rpx;
  line-height: 1.7;
  margin-bottom: 24rpx;
  color: #806231;
}
.dimension {
  margin-top: 32rpx;
}
.dimension-heading {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 25rpx;
  color: #3d5c48;
}
.dimension-track {
  height: 14rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #e8eddf;
  margin: 16rpx 0;
}
.dimension-fill {
  height: 100%;
  border-radius: 8rpx;
  background: #6f9c70;
}
.dimension-summary {
  font-size: 24rpx;
  line-height: 1.7;
  color: #73806e;
}
.archive-link {
  padding: 32rpx;
  border-radius: 28rpx;
  background: #e6efd9;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.archive-title {
  font-size: 29rpx;
  color: #24513d;
  font-weight: 600;
}
.archive-subtitle {
  color: #708267;
  font-size: 23rpx;
  margin-top: 10rpx;
}
.archive-arrow {
  color: #345c41;
  font-size: 40rpx;
}
.result-actions {
  display: flex;
  gap: 20rpx;
}
.result-actions button {
  flex: 1;
}
.primary-button,
.secondary-button {
  font-size: 28rpx;
  line-height: 1.5;
  padding: 25rpx 24rpx;
  border-radius: 48rpx;
  margin: 0;
  font-weight: 600;
}
.primary-button {
  background: #205c42;
  color: #fffdf4;
}
.secondary-button {
  background: #fffdf7;
  border: 1rpx solid #d9e1cc;
  color: #466344;
}
button::after {
  border: 0;
}
.text-button {
  background: transparent;
  font-size: 26rpx;
  color: #50704e;
  margin: 16rpx 0 0;
  padding: 10rpx;
}
.muted {
  color: #879080;
  font-size: 24rpx;
}
.state-card {
  margin-top: 60rpx;
  text-align: center;
  padding: 60rpx 32rpx;
}
.state-leaf {
  color: #789b65;
  font-size: 80rpx;
}
.state-title {
  font-size: 38rpx;
  margin: 28rpx 0 20rpx;
  font-weight: 600;
}
.state-copy {
  color: #74806f;
  font-size: 28rpx;
  line-height: 1.9;
  margin-bottom: 40rpx;
}
.pressed {
  opacity: 0.8;
}
