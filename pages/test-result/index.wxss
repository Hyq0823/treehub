page {
  background: #faf7ef;
}
.report-redirect {
  margin: 100rpx 32rpx;
  padding: 50rpx 28rpx;
  text-align: center;
  background: #fffdf8;
  border: 1rpx solid #ede9dc;
  border-radius: 30rpx;
}
.report-redirect-icon {
  font-size: 70rpx;
  color: #789b65;
}
.report-redirect-title {
  margin-top: 24rpx;
  color: #244839;
  font-size: 30rpx;
}
.report-redirect-error {
  margin: 24rpx 0;
  color: #7b8379;
  font-size: 25rpx;
  line-height: 1.7;
}
.report-redirect-retry {
  color: #fffdf4;
  background: #205c42;
  border-radius: 48rpx;
  font-size: 27rpx;
}
.report-redirect-home {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #50704e;
  background: transparent;
}
button::after {
  border: 0;
}
