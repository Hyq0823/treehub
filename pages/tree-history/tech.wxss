.history-page { position: relative; min-height: 100vh; color: #eafff9; background: radial-gradient(circle at 90% 5%, rgba(105,87,226,.14), transparent 25%), linear-gradient(160deg, #071720, #06111b 58%, #091723); overflow: hidden; }
.history-page::before { content: ''; position: fixed; inset: 0; pointer-events: none; opacity: .2; background-image: linear-gradient(rgba(99,235,210,.07) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(99,235,210,.07) 1rpx, transparent 1rpx); background-size: 54rpx 54rpx; mask-image: linear-gradient(to bottom, #000, transparent 72%); }
.history-page > view, .history-page > text { position: relative; z-index: 1; }
.history-page .eyebrow { color: #62d9c0; }.history-page .page-title { color: #f0fffb; }.history-page .page-subtitle { color: #779398; }
.history-page .snapshot-card { border-color: rgba(104,183,178,.18); background: linear-gradient(145deg, rgba(15,40,51,.95), rgba(8,27,38,.93)); box-shadow: 0 22rpx 58rpx rgba(0,0,0,.26), inset 0 1rpx rgba(255,255,255,.05); animation: historyRise .5s ease; }
.history-page .snapshot-number { color: #65e1c4; }.history-page .snapshot-date { color: #637f84; }.history-page .snapshot-art { background: radial-gradient(ellipse, rgba(68,220,188,.13), transparent 68%); }.history-page .snapshot-name { color: #effffb; }.history-page .snapshot-name text { color: #07201f; background: linear-gradient(100deg, #64e2c5, #d3c36c); }.history-page .snapshot-meaning { color: #d3c16c; }.history-page .snapshot-story { color: #86a09d; }.history-page .snapshot-footer { color: #65e0c4; border-color: rgba(103,171,170,.14); }.history-page .snapshot-footer text:first-child { color: #6d898d; }
.history-page .missing-snapshot, .history-page .local-note { color: #637f83; }.history-page .legacy-note { color: #c8ac65; }.history-page .empty-panel { color: #7b979a; border-color: rgba(103,190,179,.22); background: rgba(12,34,44,.84); }.history-page .empty-title { color: #eafff9; }.history-page .body-copy { color: #789398; }.history-page .primary-action { color: #07201e; background: linear-gradient(100deg, #62e3c5, #b1e6ad); }
@keyframes historyRise { from { opacity: 0; transform: translateY(18rpx); } to { opacity: 1; transform: none; } }
