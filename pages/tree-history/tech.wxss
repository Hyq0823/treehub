.history-page { position: relative; min-height: 100vh; color: #203a65; background: radial-gradient(circle at 90% 5%, #e6eeff, transparent 35%), linear-gradient(160deg, #edf6ff, #f6f9ff 58%, #ffffff); overflow: hidden; }
.history-page::before { content: ''; position: fixed; inset: 0; pointer-events: none; opacity: .15; background-image: radial-gradient(#a8caff 1rpx, transparent 2rpx); background-size: 54rpx 54rpx; }
.history-page > view, .history-page > text { position: relative; z-index: 1; }
.history-page .eyebrow { color: #6d9be5; }.history-page .page-title { color: #203a65; }.history-page .page-subtitle { color: #7b90af; }
.history-page .snapshot-card { border-color: #e1ebfa; background: #ffffff; box-shadow: 0 18rpx 48rpx rgba(56,106,184,.06); animation: historyRise .5s ease; }
.history-page .snapshot-number { color: #347ef2; }.history-page .snapshot-date { color: #91a3bd; }.history-page .snapshot-art { background: radial-gradient(ellipse, #edf6ff, transparent 68%); }.history-page .snapshot-name { color: #203a65; }.history-page .snapshot-name text { color: #497ccc; background: #eaf3ff; }.history-page .snapshot-meaning { color: #9e8d69; }.history-page .snapshot-story { color: #7186a5; }.history-page .snapshot-footer { color: #347ef2; border-color: #e9eff8; }.history-page .snapshot-footer text:first-child { color: #90a1ba; }
.history-page .missing-snapshot, .history-page .local-note { color: #8a9bb5; }.history-page .legacy-note { color: #ae9765; }.history-page .empty-panel { color: #7a90ae; border-color: #d4e5fc; background: #ffffff; }.history-page .empty-title { color: #203a65; }.history-page .body-copy { color: #7a90ae; }.history-page .primary-action { color: #ffffff; background: linear-gradient(100deg, #58a5ff, #2974ff); }
@keyframes historyRise { from { opacity: 0; transform: translateY(18rpx); } to { opacity: 1; transform: none; } }
