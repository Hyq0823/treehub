.hall-page {
  position: relative;
  min-height: 100vh;
  color: #eafff9;
  background: radial-gradient(circle at 88% 8%, rgba(102, 86, 225, .16), transparent 27%), radial-gradient(circle at 8% 28%, rgba(64, 218, 186, .12), transparent 28%), linear-gradient(160deg, #071720, #06111b 58%, #091723);
  overflow: hidden;
}
.hall-page::before {
  content: ''; position: fixed; inset: 0; pointer-events: none; opacity: .22;
  background-image: linear-gradient(rgba(99,235,210,.07) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(99,235,210,.07) 1rpx, transparent 1rpx); background-size: 54rpx 54rpx;
  mask-image: linear-gradient(to bottom, #000, transparent 72%);
}
.hall-page > view, .hall-page > block { position: relative; z-index: 1; }
.hall-page .eyebrow { color: #64d9c1; text-shadow: 0 0 18rpx rgba(94,231,202,.25); }
.hall-page .hall-title { color: #f0fffb; text-shadow: 0 8rpx 30rpx rgba(0,0,0,.28); }
.hall-page .title-leaf { color: #65ebc9; animation: techLeaf 2.6s ease-in-out infinite; }
.hall-page .hall-subtitle { color: #789499; }
.hall-page .tree-card {
  border-color: rgba(103, 237, 211, .24);
  background: radial-gradient(circle at 82% 48%, rgba(100, 236, 206, .13), transparent 30%), linear-gradient(135deg, rgba(15, 42, 51, .96), rgba(8, 28, 39, .92));
  box-shadow: 0 24rpx 70rpx rgba(0,0,0,.32), inset 0 1rpx rgba(255,255,255,.07);
  animation: techPanelIn .55s ease;
}
.hall-page .tree-card::before { content: ''; position: absolute; inset: 0; opacity: .22; background: repeating-linear-gradient(0deg, transparent 0 28rpx, rgba(102,234,210,.08) 29rpx 30rpx); pointer-events: none; }
.hall-page .small-label { color: #61dfc3; letter-spacing: 2rpx; }.hall-page .tree-name { color: #effff9; }.hall-page .tree-meaning { color: #97b0aa; }
.hall-page .stage-story { color: #e0cb76; background: rgba(216,196,105,.1); border: 1rpx solid rgba(216,196,105,.18); }
.hall-page .tree-stats { color: #6f8e91; }.hall-page .archive-link { color: #6fe9ce; }
.hall-page .progress-leaf { color: #24434a; text-shadow: none; }.hall-page .leaf-lit { color: #68eccb; text-shadow: 0 0 16rpx rgba(99,234,204,.5); animation: leafData 2s ease-in-out infinite alternate; }
.hall-page .hero-tree { filter: drop-shadow(0 16rpx 26rpx rgba(76,226,194,.12)); animation: treeHover 4.5s ease-in-out infinite; }
.hall-page .recommendation { border-color: rgba(122, 106, 226, .24); background: linear-gradient(110deg, rgba(45, 38, 91, .72), rgba(13, 43, 53, .86)); box-shadow: 0 14rpx 40rpx rgba(0,0,0,.2); }
.hall-page .recommend-icon { color: #d8c872; animation: signalGlow 1.8s ease-in-out infinite; }.hall-page .recommend-title { color: #d8f5ed; }.hall-page .recommend-sub { color: #7e9b9d; }.hall-page .recommend-arrow { color: #6fe6cc; }
.hall-page .section-title { color: #effffb; }.hall-page .section-caption { color: #6d898e; }
.hall-page .category { color: #769095; background: rgba(13, 35, 45, .82); border: 1rpx solid rgba(101,164,166,.14); transition: all .22s ease; }
.hall-page .category-active { color: #08201f; background: linear-gradient(100deg, #62e3c5, #b1e8ad); border-color: transparent; box-shadow: 0 0 24rpx rgba(83,218,189,.2); }
.hall-page .explore-card { border-color: rgba(112, 174, 172, .17); background: linear-gradient(145deg, rgba(14, 37, 48, .95), rgba(9, 28, 39, .92)); box-shadow: 0 18rpx 44rpx rgba(0,0,0,.24), inset 0 1rpx rgba(255,255,255,.04); transition: transform .2s ease, border-color .2s ease; animation: cardDataIn .5s ease both; }
.hall-page .explore-card:nth-child(2n) { animation-delay: .06s; }.hall-page .explore-card.collected { border-color: rgba(217, 195, 105, .42); background: radial-gradient(circle at 50% 24%, rgba(77, 223, 190, .1), transparent 32%), linear-gradient(145deg, rgba(16, 45, 51, .97), rgba(10, 31, 40, .94)); }
.hall-page .card-number { color: #527279; }.hall-page .status { color: #a28e51; background: rgba(218,194,102,.1); }.hall-page .collected .status { color: #72e7ca; background: rgba(91,225,195,.1); }
.hall-page .sticker { filter: drop-shadow(0 10rpx 16rpx rgba(0,0,0,.22)); }.hall-page .uncollected .sticker { opacity: .42; filter: grayscale(1) drop-shadow(0 8rpx 14rpx rgba(0,0,0,.18)); }
.hall-page .unlock-mark { background: #112d37; border-color: #0d2530; }.hall-page .lock-body, .hall-page .lock-shackle { border-color: #a38f54; }
.hall-page .test-title { color: #e9faf6; }.hall-page .test-prompt { color: #718e91; }.hall-page .test-meta { color: #506e74; }.hall-page .test-action { color: #65dfc4; }
.hall-page .card-pressed { opacity: 1; transform: translateY(3rpx) scale(.985); border-color: rgba(99,232,204,.48); }
.hall-page .local-note { color: #627e83; }.hall-page .hall-footnote { color: #48646b; }
.hall-page .error-card { color: #d9c77f; background: rgba(84,65,27,.4); border: 1rpx solid rgba(221,190,91,.24); }
@keyframes techPanelIn { from { opacity: 0; transform: translateY(24rpx); } to { opacity: 1; transform: none; } }
@keyframes techLeaf { 0%,100% { opacity: .55; transform: rotate(-8deg) scale(.9); } 50% { opacity: 1; transform: rotate(4deg) scale(1.06); } }
@keyframes treeHover { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-9rpx); } }
@keyframes leafData { from { opacity: .65; } to { opacity: 1; } }
@keyframes signalGlow { 0%,100% { text-shadow: 0 0 5rpx rgba(216,199,106,.2); } 50% { text-shadow: 0 0 24rpx rgba(216,199,106,.65); } }
@keyframes cardDataIn { from { opacity: 0; transform: translateY(16rpx); } to { opacity: 1; transform: none; } }
