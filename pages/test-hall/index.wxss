page { background: #edf6ff; color: #18355e; }
.hall-page { --ink: #17345f; --muted: #6684a8; min-height: 100vh; padding: 0 30rpx calc(176rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg, #d9efff 0, #edf6ff 650rpx, #f5f9ff 1180rpx, #edf5ff 100%); }
.welcome-scene { position: relative; height: 528rpx; margin: 0 -30rpx; padding: 26rpx 30rpx 0; overflow: hidden; isolation: isolate; background: radial-gradient(ellipse at 83% 20%, #fff7d88c, transparent 34%), radial-gradient(ellipse at 5% 10%, #bedfff 0, transparent 55%), linear-gradient(165deg, #87bfff 0, #cde7ff 47%, #ecf7ff 100%); }
.sky-orb { position: absolute; border-radius: 50%; filter: blur(6rpx); pointer-events: none; }.sky-orb-one { width: 135rpx; height: 63rpx; left: -40rpx; top: 310rpx; background: #fff9; box-shadow: 50rpx 10rpx 0 -3rpx #fffd, 95rpx 25rpx 0 8rpx #ffffff87; }.sky-orb-two { width: 155rpx; height: 78rpx; right: -38rpx; top: 80rpx; background: #fff9; box-shadow: -55rpx 10rpx 0 -8rpx #fff8; }.scene-mist { position: absolute; left: -50rpx; right: -50rpx; height: 130rpx; bottom: 0; background: linear-gradient(0deg, #f0f7ff 4%, #f4faffbd 45%, transparent); z-index: 2; pointer-events: none; }
.brand { position: relative; z-index: 3; display: flex; gap: 14rpx; align-items: center; }.brand-cloud { position: relative; width: 65rpx; height: 43rpx; border-radius: 28rpx; background: linear-gradient(145deg, #fff, #d4eaff); box-shadow: inset 0 -5rpx 7rpx #81b7f726, 0 7rpx 14rpx #4e8bd82b; flex: 0 0 65rpx; margin-top: 10rpx; }.brand-cloud::before { content: ''; position: absolute; width: 34rpx; height: 34rpx; left: 9rpx; top: -13rpx; border-radius: 50%; background: #f2f8ff; }.brand-cloud::after { content: ''; position: absolute; width: 27rpx; height: 27rpx; right: 7rpx; top: -5rpx; border-radius: 50%; background: #e4f0ff; }.brand-cloud > view { position: absolute; z-index: 1; top: 20rpx; left: 18rpx; width: 5rpx; height: 5rpx; border-radius: 50%; background: #5c8bd0; box-shadow: 17rpx 0 #5c8bd0; }
.hall-title { font-size: 43rpx; line-height: 1.2; font-weight: 750; letter-spacing: 1rpx; color: #fff; text-shadow: 0 3rpx 13rpx #5485bd20; }.hall-subtitle { margin-top: 10rpx; color: #fff; font-size: 23rpx; letter-spacing: 3rpx; }
.welcome-copy { position: relative; z-index: 3; width: 370rpx; margin-top: 42rpx; pointer-events: none; }.welcome-title { color: #13315b; font-size: 36rpx; font-weight: 720; line-height: 1.52; letter-spacing: 0; }.welcome-note { margin-top: 19rpx; color: #4b6d98; font-size: 24rpx; line-height: 1.75; }
.welcome-art { position: absolute; z-index: 1; width: 440rpx; height: 440rpx; top: 54rpx; right: -10rpx; }.welcome-art image { display: block; width: 100%; height: 100%; }.art-unavailable { position: absolute; top: 102rpx; right: 45rpx; width: 270rpx; text-align: center; color: #5e80aa; padding-top: 112rpx; }.art-unavailable-ring { position: absolute; width: 230rpx; height: 230rpx; border-radius: 50%; top: 0; left: 20rpx; background: #ffffff50; border: 1rpx solid #fff9; }.art-unavailable-title { position: relative; font-size: 23rpx; }.art-unavailable button { position: relative; margin-top: 15rpx; color: #4d82ca; background: #ffffffc9; border: 1rpx solid #b7d3fa; font-size: 23rpx; border-radius: 26rpx; min-height: 84rpx; padding: 0 22rpx; line-height: 84rpx; }
.scene-spark { position:absolute; z-index:2; width:22rpx; height:22rpx; transform:rotate(45deg); border-radius:4rpx; background:#fff2a4; box-shadow:0 0 13rpx #fff; pointer-events:none; }.spark-one { right:40rpx; top:161rpx; }.spark-two { left:305rpx; top:315rpx; width:16rpx; height:16rpx; }.spark-three { right:79rpx; bottom:137rpx; width:13rpx; height:13rpx; }
.tree-shortcut { position: absolute; z-index: 4; bottom: 36rpx; left: 30rpx; right: 30rpx; display: flex; align-items: center; gap: 14rpx; min-height: 118rpx; padding: 12rpx 18rpx 12rpx 10rpx; border: 2rpx solid #ffffffd9; border-radius: 28rpx; background: linear-gradient(100deg, #fffdf9f0, #ffffffc9); box-shadow: 0 10rpx 24rpx #6893c111; }.shortcut-thumb { width: 93rpx; height: 93rpx; border-radius: 20rpx; background: #e9f3ff; flex: 0 0 93rpx; overflow: hidden; display: flex; align-items: center; justify-content: center; }.shortcut-thumb image { width: 100%; height: 100%; }.shortcut-leaf { width: 32rpx; height: 45rpx; border-radius: 85% 8% 85% 8%; transform: rotate(26deg); background: #b2ceef; border: 1rpx solid #ffffff; }.shortcut-copy { flex: 1; min-width: 0; }.shortcut-title { font-size: 25rpx; line-height: 1.4; font-weight: 650; color: #234575; }.shortcut-title text { margin-left: 13rpx; font-size: 24rpx; color: #355f99; }.shortcut-note { margin-top: 8rpx; color: #6683a8; font-size: 22rpx; line-height: 1.45; }.shortcut-arrow { color: #4a86ec; font-size: 40rpx; width: 39rpx; height: 39rpx; line-height: 32rpx; text-align: center; border-radius: 50%; background: #edf5ff; }
.progress-panel { position: relative; z-index: 5; padding: 18rpx 28rpx 0; margin-top: -10rpx; border-radius: 32rpx; background: #ffffffee; border: 2rpx solid #fff; box-shadow: 0 12rpx 32rpx #7a9bcb10; }.progress-heading { display: flex; justify-content: space-between; align-items: center; font-size: 28rpx; color: #214271; font-weight: 650; }.progress-heading > view { font-size: 36rpx; color: #316ee7; font-variant-numeric: tabular-nums; }.progress-heading > view text { font-size: 27rpx; color: #6586b6; font-weight: 400; }
.progress-nodes { display: flex; margin: 12rpx 0 10rpx; }.progress-node { display: flex; align-items: center; flex: 1; }.progress-node:last-child { flex: 0 0 40rpx; }.node-circle { position: relative; z-index: 1; flex: 0 0 40rpx; width: 40rpx; height: 40rpx; text-align: center; line-height: 40rpx; border-radius: 50%; color: #8ca3c4; background: #edf3ff; font-size: 21rpx; border: 1rpx solid #e3ecfa; }.node-lit { color: #fff; background: linear-gradient(140deg, #a9d5ff 0, #4b98ff 60%, #3875ef 100%); border-color: #87bcff; box-shadow: 0 4rpx 9rpx #78affb26; }.node-lit::after { content:''; position:absolute; left:14rpx; top:8rpx; width:10rpx; height:17rpx; border-right:4rpx solid #fff; border-bottom:4rpx solid #fff; transform:rotate(45deg); }.node-line { flex: 1; height: 5rpx; background: #e4edfc; }.node-line-lit { background: #85b5ff; }
.reward-row { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; padding: 11rpx 0 14rpx; border-top: 1rpx solid #edf2fb; min-height: 88rpx; }.reward-copy { flex: 1; min-width: 0; }.reward-title { color: #5779a5; font-size: 23rpx; font-weight: 550; line-height: 1.5; }.reward-note { margin-top: 5rpx; font-size: 20rpx; line-height: 1.5; color: #889db9; }.reward-gift { position: relative; width: 65rpx; height: 62rpx; flex: 0 0 65rpx; }.gift-box { position: absolute; bottom: 1rpx; left: 10rpx; width: 48rpx; height: 38rpx; border-radius: 3rpx 3rpx 7rpx 7rpx; background: linear-gradient(100deg, #ffe6a6, #ffcb66 75%, #f1b956); box-shadow: 0 4rpx 9rpx #e4b5682b; }.gift-lid { position: absolute; bottom: 35rpx; left: 6rpx; width: 56rpx; height: 13rpx; z-index: 2; border-radius: 3rpx; background: linear-gradient(100deg, #fff0bf, #ffd16e); }.gift-ribbon { position: absolute; z-index: 3; width: 10rpx; height: 51rpx; left: 28rpx; bottom: 1rpx; background: #faaf70; border-left: 2rpx solid #fff1c8; border-right: 1rpx solid #f8e9d9; }.gift-bow { position: absolute; z-index: 4; top: 1rpx; width: 25rpx; height: 18rpx; border: 5rpx solid #f6c56e; border-radius: 70% 50% 50% 40%; }.bow-left { left: 10rpx; transform: rotate(25deg); }.bow-right { right: 6rpx; transform: rotate(-25deg); }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 15rpx; margin: 22rpx 3rpx 18rpx; }.section-title { font-size: 31rpx; font-weight: 700; color: #193d70; }.section-subtitle { margin-top: 8rpx; font-size: 22rpx; line-height: 1.5; color: #7b93b1; }.section-caption { flex: 0 0 auto; font-size: 23rpx; line-height: 92rpx; min-height: 92rpx; color: #6e88ad; }
.category-scroll { width: 100%; margin: -5rpx 0 20rpx; white-space: nowrap; }.categories { display: flex; gap: 13rpx; }.category { display: flex; align-items: center; justify-content: center; min-width: 112rpx; min-height: 84rpx; padding: 0 27rpx; box-sizing: border-box; border-radius: 35rpx; color: #6682aa; background: #ffffffb8; font-size: 25rpx; border: 1rpx solid #e0eafb; flex-shrink: 0; }.category-active { background: #4b8bf4; border-color: #4b8bf4; color: #fff; box-shadow: 0 5rpx 13rpx #85b0f02b; }
.test-grid { display: flex; flex-direction: column; gap: 20rpx; }.explore-card { display: flex; align-items: center; gap: 19rpx; padding: 12rpx 19rpx 12rpx 12rpx; border: 2rpx solid #ffffff; border-radius: 29rpx; background: #fff; box-shadow: 0 9rpx 25rpx #7094c10d; min-height: 176rpx; transition: transform .18s ease; }.explore-card.collected { border-color: #c8ddfa; }
.test-art { position: relative; width: 150rpx; height: 150rpx; flex: 0 0 150rpx; border-radius: 23rpx; overflow: hidden; background: linear-gradient(150deg, #def2ff, #d4dfff 70%, #f6e8fb); }.test-art-image { display: block; width: 100%; height: 100%; transform: scale(1.07); }.art-compass { background: linear-gradient(150deg, #fff5d8, #e8efff); }.art-moon { background: linear-gradient(150deg, #d3dfff, #dcd6fc); }.art-energy { background: linear-gradient(150deg, #e0f2ff, #e9f5ff); }.art-leaves { background: linear-gradient(150deg, #e7eaff, #dfecff); }.art-glint { position: absolute; width: 12rpx; height: 12rpx; right: 12rpx; top: 12rpx; background: #fff9da; box-shadow: 0 0 10rpx #fff; border-radius: 50%; pointer-events: none; }.test-art-empty { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 13rpx; }.art-empty-leaf { width: 35rpx; height: 46rpx; border-radius: 85% 8% 85% 8%; transform: rotate(28deg); border: 1rpx solid #ffffffd9; background: #adcaef; }.test-art-empty text { font-size: 19rpx; color: #7193be; }
.test-copy { flex: 1; min-width: 0; }.test-heading { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; }.test-title { color: #163966; font-size: 28rpx; font-weight: 650; line-height: 1.4; }.status { color: #5787cd; background: #edf5ff; padding: 3rpx 8rpx; font-size: 23rpx; border-radius: 12rpx; }.test-prompt { color: #6b83a4; font-size: 25rpx; line-height: 1.55; margin-top: 9rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }.test-meta { display: flex; flex-wrap: wrap; gap: 9rpx; margin-top: 9rpx; color: #8a9db7; font-size: 23rpx; line-height: 1.4; }.test-meta > text { color: #b0bed1; }.test-action { width: 40rpx; height: 40rpx; line-height: 34rpx; border-radius: 50%; text-align: center; color: #4385f4; background: #eaf4ff; flex: 0 0 40rpx; font-size: 36rpx; }
.card-pressed { transform: scale(.985); opacity: .92; }.empty-category { padding: 40rpx 20rpx; text-align: center; color: #7890b3; font-size: 25rpx; }.keyword-note { margin-top: 28rpx; color: #7d94b1; text-align: center; font-size: 23rpx; line-height: 1.8; }.privacy-entry { display:flex; min-height:92rpx; margin-top:28rpx; align-items:center; justify-content:center; flex-direction:column; text-align:center; font-size:23rpx; color:#718cab; line-height:1.8; }.privacy-entry text { display: block; color: #527fba; }.hall-footnote { color: #839bb6; text-align: center; font-size: 23rpx; margin-top: 10rpx; line-height: 1.7; }.error-card { margin-top: 40rpx; padding: 30rpx; border-radius: 27rpx; border: 1rpx solid #e6eefa; background: #fff; color: #6683a8; font-size: 25rpx; line-height: 1.8; }.error-title { margin-bottom: 18rpx; color: #214571; font-size: 35rpx; font-weight: 700; }.error-card button { margin-top: 25rpx; border-radius: 40rpx; background: #5b92ee; color: #fff; font-size: 26rpx; min-height: 92rpx; line-height: 92rpx; }
.hall-theme-moon .welcome-scene { background: radial-gradient(circle at 82% 36%, #7c8bd3, transparent 38%), linear-gradient(165deg, #25396d, #5f7ab8 65%, #dce8ff); }.hall-theme-moon .welcome-title { color: #fff; }.hall-theme-moon .welcome-note { color: #e0e9ff; }.hall-theme-moon .scene-mist { background: linear-gradient(0deg, #eff5ff, #eff5ff7a 45%, transparent); }
.hall-theme-romantic .welcome-scene { background: radial-gradient(ellipse at 82% 35%, #fff2ce, transparent 45%), linear-gradient(155deg, #a9d0fa, #e7f3ff 55%, #fff8ea); }.hall-theme-romantic .hall-title { color: #245384; text-shadow: none; }.hall-theme-romantic .hall-subtitle { color: #4d7ba7; }
button { margin: 0; }button::after { border: 0; }
@media (prefers-reduced-motion: reduce) { .card-pressed { transition: none; } }

.section-caption { display: flex; align-items: center; gap: 10rpx; }.filter-chevron { width: 10rpx; height: 10rpx; border-right: 2rpx solid #7396c4; border-bottom: 2rpx solid #7396c4; transform: rotate(45deg); margin-top: -4rpx; }.filter-open { transform: rotate(225deg); margin-top: 6rpx; }

.welcome-art image { animation: hall-tree-drift 7s ease-in-out infinite; }.welcome-art image, .tree-shortcut, .explore-card { will-change: transform; }
@keyframes hall-tree-drift { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-5rpx); } }
@media (prefers-reduced-motion: reduce) { .welcome-art image { animation: none; } }
