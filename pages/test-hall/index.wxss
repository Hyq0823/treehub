@import "./tech.wxss";
page {
  background: #faf7f0;
  color: #172c37;
}
.hall-page {
  padding: 38rpx 30rpx 48rpx;
  background: radial-gradient(ellipse at 100% 0, #e7eddb66, transparent 40%);
}
.eyebrow {
  font-size: 18rpx;
  letter-spacing: 5rpx;
  color: #8b947e;
  margin-bottom: 10rpx;
}
.hall-title {
  font-family: Georgia, "Songti SC", serif;
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #172d42;
  line-height: 1.3;
}
.title-leaf {
  font-size: 52rpx;
  color: #91ac79;
  margin-left: 14rpx;
}
.hall-subtitle {
  font-size: 26rpx;
  color: #7b817b;
  letter-spacing: 3rpx;
  margin-top: 8rpx;
}
.tree-card {
  position: relative;
  overflow: hidden;
  min-height: 310rpx;
  margin-top: 32rpx;
  padding: 32rpx 28rpx;
  border-radius: 30rpx;
  background: linear-gradient(125deg, #edf1df, #e4ecd955);
  border: 1rpx solid #e0e6d5;
}
.tree-card-copy {
  position: relative;
  z-index: 2;
  max-width: 69%;
}
.small-label {
  font-size: 20rpx;
  color: #687a57;
  letter-spacing: 1rpx;
}
.tree-name {
  font-family: Georgia, "Songti SC", serif;
  font-size: 43rpx;
  color: #294f3b;
  font-weight: 700;
  margin: 10rpx 0;
}
.tree-meaning {
  font-size: 23rpx;
  color: #6a785e;
  line-height: 1.7;
}
.stage-story {
  display: inline-block;
  margin-top: 10rpx;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 253, 241, 0.72);
  color: #8a743f;
  font-size: 19rpx;
}
.tree-stats {
  font-size: 21rpx;
  color: #6a7567;
  margin-top: 16rpx;
}
.leaf-progress {
  align-items: center;
  flex-wrap: wrap;
  display: flex;
  gap: 8rpx;
  margin-top: 6rpx;
}
.progress-leaf {
  font-size: 37rpx;
  line-height: 1.2;
  color: #c9d2bb;
}
.leaf-lit {
  color: #3c7a56;
}
.archive-link {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #286446;
  font-weight: 600;
}
.archive-link text {
  margin-left: 12rpx;
}
.hero-tree {
  position: absolute;
  right: -25rpx;
  bottom: 10rpx;
  width: 280rpx;
  opacity: 0.95;
}
.recommendation {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 23rpx 24rpx;
  background: linear-gradient(110deg, #faedbf, #fff2d3);
  border: 1rpx solid #f1e3b5;
  border-radius: 22rpx;
  margin: 22rpx 0 40rpx;
}
.recommend-icon {
  font-size: 48rpx;
  color: #ad8435;
}
.recommend-copy {
  flex: 1;
  min-width: 0;
}
.recommend-title {
  font-size: 25rpx;
  color: #69562e;
  font-weight: 600;
  line-height: 1.5;
}
.recommend-sub {
  font-size: 21rpx;
  color: #948161;
  margin-top: 6rpx;
  line-height: 1.5;
}
.recommend-arrow {
  font-size: 34rpx;
  color: #866b35;
}
.section-heading {
  display: flex;
  align-items: baseline;
  gap: 18rpx;
  margin-bottom: 22rpx;
}
.section-title {
  font-family: "Songti SC", serif;
  font-size: 36rpx;
  font-weight: 700;
  color: #203346;
}
.section-caption {
  font-size: 21rpx;
  color: #8b9288;
}
.category-scroll {
  width: 100%;
  margin-bottom: 24rpx;
  white-space: nowrap;
}
.categories {
  display: flex;
  gap: 14rpx;
}
.category {
  padding: 14rpx 33rpx;
  background: #edf0e9;
  color: #798176;
  font-size: 25rpx;
  border-radius: 40rpx;
  flex-shrink: 0;
}
.category-active {
  background: #286346;
  color: #fff;
}
.test-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 22rpx 0;
}
.explore-card {
  box-sizing: border-box;
  width: calc(50% - 10rpx);
  padding: 21rpx 23rpx 24rpx;
  background: #fffdf8;
  border: 2rpx solid #eeeee3;
  border-radius: 27rpx;
  box-shadow: 0 7rpx 18rpx #2c3d2b08;
  overflow: hidden;
}
.explore-card.collected {
  border-color: #dbbc72;
  background: linear-gradient(155deg, #fffdf4, #fffdf9);
}
.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card-number {
  font-size: 20rpx;
  font-family: Georgia, serif;
  color: #b2b9a9;
}
.status {
  font-size: 19rpx;
  padding: 5rpx 12rpx;
  border-radius: 20rpx;
  background: #f7edcf;
  color: #9c864a;
}
.collected .status {
  background: #e6efd9;
  color: #4e7351;
}
.sticker {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 12rpx auto;
  width: 168rpx;
  height: 158rpx;
  color: var(--sticker-color);
}
.sticker-orbit {
  position: absolute;
  width: 130rpx;
  height: 130rpx;
  border-radius: 55% 45% 40% 60%;
  background: currentColor;
  opacity: 0.08;
  transform: rotate(-12deg);
}
.sticker-symbol {
  position: relative;
  font-family: Georgia, serif;
  font-size: 126rpx;
  line-height: 1;
  color: inherit;
  text-shadow: 3rpx 5rpx #0000000a;
}
.sticker-compass .sticker-orbit {
  border: 2rpx solid currentColor;
  background: transparent;
  opacity: 0.4;
  border-radius: 50%;
}
.sticker-leaves .sticker-symbol {
  transform: rotate(-15deg);
}
.sticker-moon .sticker-symbol {
  font-size: 139rpx;
  transform: rotate(-12deg);
}
.sticker-mask .sticker-symbol {
  font-size: 145rpx;
}
.uncollected .sticker {
  color: #a8b7a1 !important;
}
.uncollected .sticker-symbol {
  opacity: 0.6;
}
.unlock-mark {
  position: absolute;
  bottom: 12rpx;
  right: 9rpx;
  background: #fff0c6;
  color: #9e8037;
  border: 4rpx solid #fffdf8;
  border-radius: 50%;
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  text-align: center;
  font-size: 28rpx;
}
.test-title {
  font-size: 29rpx;
  color: #24394a;
  font-weight: 600;
  line-height: 1.4;
  min-height: 41rpx;
}
.test-prompt {
  font-size: 22rpx;
  color: #889080;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin: 8rpx 0 14rpx;
}
.test-meta {
  font-size: 20rpx;
  color: #9b9b88;
  line-height: 1.5;
}
.test-action {
  font-size: 24rpx;
  color: #34704c;
  font-weight: 600;
  margin-top: 15rpx;
  display: flex;
  justify-content: space-between;
}
.card-pressed {
  opacity: 0.82;
  transform: translateY(2rpx);
}
.local-note {
  text-align: center;
  font-size: 22rpx;
  color: #92998c;
  margin-top: 38rpx;
}
.hall-footnote {
  text-align: center;
  font-size: 20rpx;
  color: #a9ae9e;
  margin-top: 12rpx;
}
.error-card {
  padding: 32rpx;
  background: #fff7e2;
  border-radius: 20rpx;
  margin-top: 30rpx;
  color: #7c6440;
  font-size: 27rpx;
  line-height: 1.7;
}
.error-card button {
  margin-top: 24rpx;
  font-size: 25rpx;
  color: #346548;
}
.empty-category {
  padding: 60rpx 20rpx;
  text-align: center;
  color: #8c9484;
  font-size: 25rpx;
}

.more-leaves {
  font-size: 20rpx;
  color: #7b8b6c;
}

.sticker {
  width: 178rpx;
  height: 178rpx;
}
.sticker-clip {
  position: absolute;
  inset: 8rpx;
  overflow: hidden;
}
.sticker-image {
  position: absolute;
  width: 534rpx;
  height: 356rpx;
  max-width: none;
}
.uncollected .sticker-image {
  filter: grayscale(1);
  opacity: 0.38;
}
.lock-shackle {
  position: absolute;
  top: 7rpx;
  left: 12rpx;
  width: 13rpx;
  height: 13rpx;
  border: 3rpx solid #a48132;
  border-bottom: none;
  border-radius: 8rpx 8rpx 0 0;
}
.lock-body {
  position: absolute;
  top: 20rpx;
  left: 10rpx;
  width: 22rpx;
  height: 16rpx;
  border-radius: 4rpx;
  background: #a48132;
}
