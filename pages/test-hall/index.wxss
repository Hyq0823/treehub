page { color: #173563; background: #f2f7ff; }
.hall-page { min-height: 100vh; padding: 32rpx 30rpx calc(44rpx + env(safe-area-inset-bottom)); background: radial-gradient(ellipse at 98% 0, #dcecff 0, transparent 37%), linear-gradient(180deg, #f1f7ff, #fbfcff 60%, #f0f6ff); }
.eyebrow { color: #7b9bd0; font-size: 17rpx; letter-spacing: 4rpx; }
.hall-title { margin-top: 7rpx; color: #17376d; font-size: 51rpx; font-weight: 750; line-height: 1.3; letter-spacing: 2rpx; }
.title-leaf { margin-left: 13rpx; color: #d6b36c; font-size: 35rpx; }
.hall-subtitle { margin-top: 11rpx; color: #8095b2; font-size: 25rpx; letter-spacing: 2rpx; }
.welcome-card { position: relative; display: flex; align-items: center; min-height: 242rpx; margin-top: 28rpx; padding: 28rpx; border: 1rpx solid #ffffff; border-radius: 32rpx; overflow: hidden; background: radial-gradient(circle at 93% 30%, #b7d8ff90, transparent 60%), linear-gradient(135deg, #e2efff, #f6fbff 65%, #e7edff); box-shadow: 0 14rpx 40rpx #6596d611, inset 0 2rpx #ffffff; }
.welcome-copy { position: relative; z-index: 2; width: 68%; }
.welcome-kicker { color: #7293c8; font-size: 18rpx; letter-spacing: 3rpx; }
.welcome-title { margin-top: 16rpx; font-size: 31rpx; font-weight: 700; color: #24477f; line-height: 1.5; }
.welcome-note { margin-top: 15rpx; font-size: 22rpx; line-height: 1.8; color: #879dbb; }
.welcome-art { position: absolute; right: -6rpx; top: 8rpx; bottom: 0; width: 250rpx; display: flex; align-items: center; justify-content: center; opacity: .95; }
.welcome-art image { width: 100%; height: 100%; }
.tree-shortcut { display: flex; gap: 18rpx; align-items: center; margin: 18rpx 0 24rpx; padding: 21rpx 24rpx; border: 1rpx solid #e3ecfa; border-radius: 23rpx; background: #ffffffed; }
.shortcut-symbol { width: 67rpx; height: 67rpx; border-radius: 21rpx; color: #668de0; background: linear-gradient(135deg, #edf4ff, #d6e7ff); font-size: 45rpx; line-height: 67rpx; text-align: center; }
.shortcut-copy { flex: 1; min-width: 0; }.shortcut-title { color: #254478; font-weight: 650; font-size: 25rpx; }.shortcut-title text { margin-left: 14rpx; font-size: 22rpx; color: #6d8cbe; font-weight: 400; }.shortcut-note { margin-top: 6rpx; color: #8b9eb8; font-size: 20rpx; }.shortcut-arrow { color: #5b8fe9; font-size: 31rpx; }
.progress-panel { padding: 27rpx 26rpx 20rpx; border: 1rpx solid #e1ecfb; border-radius: 29rpx; background: #fff; box-shadow: 0 12rpx 36rpx #648fc308; }
.progress-heading { display: flex; justify-content: space-between; align-items: center; color: #254477; font-size: 26rpx; font-weight: 650; }.progress-heading > view { color: #347af0; font-size: 37rpx; }.progress-heading > view text { color: #a0b2ce; font-size: 23rpx; font-weight: 400; }
.progress-nodes { display: flex; margin: 24rpx 0 18rpx; padding: 0 5rpx; }.progress-node { position: relative; flex: 1; display: flex; align-items: center; }.progress-node:last-child { flex: 0 0 40rpx; }.node-circle { position: relative; z-index: 1; width: 39rpx; height: 39rpx; line-height: 39rpx; border-radius: 50%; color: #93aad0; background: #edf3fd; font-size: 19rpx; text-align: center; }.node-lit { color: #fff; background: linear-gradient(145deg, #72b3ff, #3976ee); box-shadow: 0 4rpx 10rpx #7eaffb40; }.node-line { flex: 1; height: 4rpx; background: #e7effb; }.node-line-lit { background: #97bdfa; }
.progress-note { color: #8b9eb9; font-size: 21rpx; line-height: 1.7; }
.recommendation { display: flex; align-items: center; gap: 20rpx; padding: 20rpx; margin-top: 20rpx; border-radius: 18rpx; background: linear-gradient(110deg, #edf4ff, #f5f2ff); }.recommend-copy { flex: 1; min-width: 0; }.recommend-title { color: #5075b0; font-size: 23rpx; font-weight: 600; line-height: 1.55; }.recommend-sub { margin-top: 6rpx; color: #9aacc5; font-size: 19rpx; }.recommend-arrow { color: #6d92d7; font-size: 29rpx; }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 14rpx; margin: 35rpx 2rpx 21rpx; }.section-title { color: #234271; font-size: 31rpx; font-weight: 700; }.section-caption { color: #9aaac0; font-size: 20rpx; }
.category-scroll { width: 100%; margin-bottom: 22rpx; white-space: nowrap; }.categories { display: flex; gap: 14rpx; }.category { padding: 12rpx 28rpx; border: 1rpx solid #e5edfa; border-radius: 40rpx; color: #8298b9; background: #ffffffb8; font-size: 23rpx; flex-shrink: 0; }.category-active { color: #fff; border-color: #4d8cf8; background: linear-gradient(100deg, #6aa7fc, #3f7df0); box-shadow: 0 5rpx 16rpx #72a4ee33; }
.test-grid { display: flex; flex-direction: column; gap: 17rpx; }.explore-card { display: flex; align-items: center; gap: 20rpx; padding: 23rpx 22rpx; border: 1rpx solid #e4edf9; border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 26rpx #638ab607; transition: transform .18s ease; }.explore-card.collected { border-color: #ccdefa; }
.test-art { position: relative; width: 118rpx; height: 118rpx; flex: 0 0 118rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 24rpx; background: linear-gradient(145deg, #eaf4ff, #d9e6ff 60%, #f2e8fc); box-shadow: inset 0 2rpx 1rpx #fff; }.test-art text { position: relative; z-index: 1; font-family: Georgia, serif; color: var(--art-color); font-size: 76rpx; text-shadow: 0 5rpx 0 #ffffffb3, 0 8rpx 17rpx #a2b5d640; }.art-orbit { position: absolute; width: 91rpx; height: 91rpx; border: 1rpx solid #fff; border-radius: 50%; transform: rotate(-24deg) scaleY(.6); }.art-spark { position: absolute; width: 10rpx; height: 10rpx; border-radius: 50%; right: 17rpx; top: 16rpx; background: #fff9d9; box-shadow: 0 0 14rpx #fff; }.art-compass { background: linear-gradient(145deg, #fff6dc, #edf1ff); }.art-moon { background: linear-gradient(145deg, #e6eaff, #eee3ff); }.art-leaves { background: linear-gradient(145deg, #e5f5ff, #dcecff); }.art-energy { background: linear-gradient(145deg, #def3ff, #e8f0ff); }
.test-copy { flex: 1; min-width: 0; }.test-heading { display: flex; gap: 10rpx; align-items: center; flex-wrap: wrap; }.test-title { color: #254473; font-size: 27rpx; font-weight: 650; line-height: 1.4; }.status { color: #6590d4; background: #edf4ff; padding: 3rpx 10rpx; border-radius: 12rpx; font-size: 17rpx; white-space: nowrap; }.test-prompt { color: #8b9fbb; font-size: 21rpx; line-height: 1.65; margin-top: 8rpx; }.test-meta { color: #a0afc4; font-size: 19rpx; margin-top: 8rpx; }.test-action { width: 36rpx; height: 36rpx; line-height: 31rpx; text-align: center; background: #edf4ff; border-radius: 50%; color: #6f9be3; font-size: 35rpx; flex-shrink: 0; }
.card-pressed { transform: scale(.985); opacity: .92; }.empty-category { color: #8ca0bf; font-size: 24rpx; padding: 35rpx 20rpx; text-align: center; }.keyword-note { padding-top: 30rpx; color: #9aacbe; font-size: 19rpx; line-height: 1.9; text-align: center; }.privacy-entry { margin: 28rpx 0 12rpx; text-align: center; font-size: 19rpx; color: #849aba; line-height: 1.8; }.privacy-entry text { display: block; color: #7599cf; }.hall-footnote { color: #a2b1c7; font-size: 18rpx; text-align: center; line-height: 1.8; }.error-card { margin-top: 35rpx; padding: 28rpx; border: 1rpx solid #f0dfc4; background: #fff9ef; border-radius: 24rpx; color: #a1865b; font-size: 25rpx; line-height: 1.8; }.error-card button { color: #fff; background: #598cf1; border-radius: 40rpx; font-size: 24rpx; margin-top: 18rpx; }.error-card button::after { border: 0; }
.welcome-note, .test-prompt { color: #60799a; }.shortcut-note, .progress-note, .recommend-sub { color: #7188a6; }.test-meta, .privacy-entry { color: #788da9; }
