:host { position: fixed; bottom: 0; left: 0; right: 0; z-index: 80; }
.tab-bar { display: flex; padding: 6rpx 18rpx calc(8rpx + env(safe-area-inset-bottom)); background: #ffffff; border-top: 1rpx solid #e4edfc; }
.tab-item { position: relative; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 7rpx; flex: 1; min-height: 96rpx; color: #7283a6; transition: color 160ms ease, opacity 140ms ease; }
.tab-item > text { font-size: 23rpx; line-height: 1.25; }.tab-selected { color: #246bfa; }.tab-selected > text { font-weight: 650; }.tab-pressed { opacity: .65; }
.tab-dot { position: absolute; top: 0; width: 5rpx; height: 5rpx; border-radius: 50%; background: #246bfa; }
.tab-symbol { position: relative; width: 43rpx; height: 43rpx; color: inherit; }.symbol-part { position: absolute; box-sizing: border-box; }
.symbol-home .part-one { width: 29rpx; height: 29rpx; left: 7rpx; top: 11rpx; border: 3rpx solid currentColor; border-top: 0; border-radius: 3rpx 3rpx 6rpx 6rpx; }
.symbol-home .part-two { width: 29rpx; height: 29rpx; left: 7rpx; top: 3rpx; border-top: 3rpx solid currentColor; border-left: 3rpx solid currentColor; border-radius: 3rpx; transform: rotate(45deg); }
.symbol-home .part-three { left: 17rpx; bottom: 3rpx; width: 10rpx; height: 16rpx; border: 3rpx solid currentColor; border-bottom: 0; border-radius: 3rpx 3rpx 0 0; background: #ffffff; }
.tab-selected .symbol-home .part-one { background: #246bfa; }.tab-selected .symbol-home .part-three { border-color: #ffffff; }
.symbol-tree .part-one { width: 25rpx; height: 25rpx; top: 1rpx; left: 9rpx; border: 3rpx solid currentColor; border-radius: 50%; background: #ffffff; }
.symbol-tree .part-two { width: 24rpx; height: 24rpx; top: 11rpx; left: 0; border: 3rpx solid currentColor; border-right-color: transparent; border-radius: 50%; background: #ffffff; }
.symbol-tree .part-three { width: 24rpx; height: 24rpx; top: 11rpx; right: 0; border: 3rpx solid currentColor; border-left-color: transparent; border-radius: 50%; background: #ffffff; }
.symbol-tree .part-four { height: 24rpx; width: 14rpx; bottom: 0; left: 15rpx; border-left: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; border-radius: 0 0 0 3rpx; }
.tab-selected .symbol-tree .part-one, .tab-selected .symbol-tree .part-two, .tab-selected .symbol-tree .part-three { background: #e7f1ff; }
.symbol-archive .part-one { inset: 1rpx 5rpx 0; border: 3rpx solid currentColor; border-radius: 6rpx; }
.symbol-archive .part-two { left: 15rpx; right: 12rpx; height: 3rpx; top: 12rpx; border-radius: 2rpx; background: currentColor; }
.symbol-archive .part-three { left: 15rpx; right: 12rpx; height: 3rpx; top: 21rpx; border-radius: 2rpx; background: currentColor; }
.symbol-archive .part-four { left: 15rpx; right: 17rpx; height: 3rpx; top: 30rpx; border-radius: 2rpx; background: currentColor; }
