/* 全局样式 */
page {
  background-color: #06121c;
  font-family:
    "PingFang SC",
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    "Helvetica Neue",
    Arial,
    sans-serif;
}

/* 配色变量 */
page {
  --deep-blue: #0b2935;
  --sky-blue: #63e3c5;
  --light-blue: #14343e;
  --emerald: #62e4c6;
  --white: #102934;
  --warm-gray: #06121c;
  --dark-gray: #eafff9;
  --medium-gray: #809b9e;
  --light-gray: #607c82;
}

/* 卡片样式 */
.card {
  color: #eafff9;
  background: rgba(14, 38, 49, .92);
  border: 1px solid rgba(100, 229, 204, .16);
  border-radius: 20px;
  padding: 16px;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.05);
  margin-bottom: 12px;
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(100deg, #62e4c6, #b3e5aa);
  color: #06201e;
  border-radius: 30px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  font-weight: 600;
  margin-top: 16px;
  font-family: "PingFang SC", sans-serif;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-secondary {
  background-color: var(--white);
  border: 2px solid var(--sky-blue);
  color: var(--sky-blue);
  border-radius: 8px;
  padding: 12px;
  text-align: center;
  font-size: 16px;
  font-weight: 600;
  transition: all 0.2s ease;
  font-family: "PingFang SC", sans-serif;
}

.btn-secondary:active {
  opacity: 0.8;
}

/* 进度条样式 */
.progress-bar {
  height: 10px;
  background-color: #e5e7eb;
  border-radius: 5px;
  overflow: hidden;
  margin: 16px 0;
}

.progress-bar-fill {
  height: 100%;
  background-color: var(--sky-blue);
  border-radius: 5px;
  transition: width 0.3s ease;
}

/* 注意事项样式 */
.notice {
  background-color: #fffbeb;
  border: 1px solid #fcd34d;
  border-radius: 12px;
  padding: 12px;
  margin-top: 16px;
  font-size: 14px;
  color: var(--dark-gray);
  font-family: "PingFang SC", sans-serif;
}

.notice-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--dark-gray);
  margin-bottom: 8px;
  display: flex;
  align-items: center;
  gap: 4px;
  font-family: "PingFang SC", sans-serif;
}

.notice-title::before {
  content: "⚠️";
}

.notice-content {
  font-size: 12px;
  color: var(--dark-gray);
  line-height: 1.5;
  font-family: "PingFang SC", sans-serif;
}

.notice-content view {
  margin-bottom: 4px;
  display: list-item;
  list-style-type: disc;
  list-style-position: inside;
}
